                        <DataGridTextColumn x:Name="ColVersion" Header="Version" Binding="{Binding FileVersion}" SortMemberPath="FileVersion" Width="105" Visibility="Collapsed" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn x:Name="ColCommandLine" Header="Command Line" Binding="{Binding CommandLine}" SortMemberPath="CommandLine" Width="280" Visibility="Collapsed">
