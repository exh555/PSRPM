                            <TextBlock x:Name="TxtNetStatusCounts" Text="Endpoints: 0  |  Established: 0  |  Listening: 0  |  Time Wait: 0  |  Close Wait: 0" FontWeight="SemiBold" FontSize="{DynamicResource GridFontSize}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                        </DockPanel>
                    </Border>

                    <!-- DataGrids Container + Empty State Overlay -->
                    <Grid>
                        <!-- Sub-Mode A: System-Wide Active Sockets Grid -->
                        <DataGrid x:Name="GridNetworkSockets" AutomationProperties.Name="Active Network Sockets Table"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}"
                                  Background="{DynamicResource BrushSurfaceBg}"
                                  Foreground="{DynamicResource BrushTextPrimary}"
                                  RowHeaderWidth="0" RowHeight="{DynamicResource GridRowHeight}" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="{DynamicResource GridHeaderFontSize}"/>
                                    <Setter Property="Padding" Value="{DynamicResource GridHeaderPadding}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding LifecycleState}" Value="New">
                                            <Setter Property="Background" Value="{DynamicResource BrushNetRowNewBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushNetRowNewFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LifecycleState}" Value="Mod">
                                            <Setter Property="Background" Value="{DynamicResource BrushNetRowModBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushNetRowModFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LifecycleState}" Value="Del">
                                            <Setter Property="Background" Value="{DynamicResource BrushNetRowDelBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushNetRowDelFg}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LifecycleState}" Value="New">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushNetRowNewFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LifecycleState}" Value="Mod">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushNetRowModFg}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LifecycleState}" Value="Del">
                                            <Setter Property="Foreground" Value="{DynamicResource BrushNetRowDelFg}"/>
                                        </DataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Process Name" SortMemberPath="ProcessName" Width="142" MinWidth="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                                                <Image Source="{Binding IconSource}" Width="{DynamicResource GridIconSize}" Height="{DynamicResource GridIconSize}" Margin="{DynamicResource GridIconMargin}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="{DynamicResource GridFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Process ID" Binding="{Binding PIDDisplay}" SortMemberPath="PID" Width="68" MinWidth="60" ElementStyle="{StaticResource RightTabularText}"/>

                                <DataGridTemplateColumn Header="Protocol" SortMemberPath="Protocol" Width="56" MinWidth="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding ProtocolBg}" CornerRadius="2" Padding="{DynamicResource GridBadgePadding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Protocol}" Foreground="{Binding ProtocolFg}" FontSize="{DynamicResource GridBadgeFontSize}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="State" SortMemberPath="State" Width="84" MinWidth="74">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StateBg}" CornerRadius="2" Padding="{DynamicResource GridBadgePadding}" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding State}" Foreground="{Binding StateFg}" FontSize="{DynamicResource GridBadgeFontSize}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Local Address" Binding="{Binding LocalAddress}" SortMemberPath="LocalAddress" Width="100" MinWidth="85" ElementStyle="{StaticResource EllipsisCellText}"/>
                                <DataGridTextColumn Header="Local Port" Binding="{Binding LocalPortDisplay}" SortMemberPath="LocalPort" Width="68" MinWidth="58" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteAddress}" SortMemberPath="RemoteAddress" Width="108" MinWidth="90" ElementStyle="{StaticResource EllipsisCellText}"/>
                                <DataGridTextColumn Header="Remote Port" Binding="{Binding RemotePortDisplay}" SortMemberPath="RemotePort" Width="78" MinWidth="64" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Create Time" Binding="{Binding CreateTime}" SortMemberPath="CreateTimestamp" Width="118" MinWidth="98" ElementStyle="{StaticResource EllipsisCellText}"/>
                                <DataGridTextColumn Header="Module Name" Binding="{Binding ModuleName}" SortMemberPath="ModuleName" Width="96" MinWidth="85" ElementStyle="{StaticResource EllipsisCellText}"/>
                                <DataGridTextColumn Header="Sent Packets" Binding="{Binding SentPacketsFormatted}" SortMemberPath="SentPackets" Width="84" MinWidth="74" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Recv Packets" Binding="{Binding RecvPacketsFormatted}" SortMemberPath="RecvPackets" Width="84" MinWidth="74" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Sent Bytes" Binding="{Binding SentBytesFormatted}" SortMemberPath="SentBytes" Width="70" MinWidth="60" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Recv Bytes" Binding="{Binding RecvBytesFormatted}" SortMemberPath="RecvBytes" Width="70" MinWidth="60" ElementStyle="{StaticResource RightTabularText}"/>
                            </DataGrid.Columns>

                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource ContextMenuStyle}">
                                    <MenuItem x:Name="CtxNetSockCloseConn" Header="Close Connection..." IsEnabled="False"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxNetSockFilterProc" Header="Filter to Selected Process"/>
                                    <MenuItem x:Name="CtxNetSockFilterRemote" Header="Filter to Remote Address"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxNetSockGoToProcess" Header="Select Process in Tree"/>
                                    <MenuItem x:Name="CtxNetSockPropsTcp" Header="Process Properties (TCP/IP Tab)..." FontWeight="Bold"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxNetSockCopyDetails" Header="Copy Details"/>
                                    <MenuItem x:Name="CtxNetSockCopyLocal" Header="Copy Local Endpoint"/>
                                    <MenuItem x:Name="CtxNetSockCopyRemote" Header="Copy Remote Endpoint"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <!-- Sub-Mode B: Client ETW Activity Stream Grid -->
                        <DataGrid x:Name="GridNetworkTimeline" AutomationProperties.Name="ETW Network Activity Stream Table" Visibility="Collapsed"
                                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}"
                                  Background="{DynamicResource BrushSurfaceBg}"
                                  Foreground="{DynamicResource BrushTextPrimary}"
                                  RowHeaderWidth="0" RowHeight="{DynamicResource GridRowHeight}" BorderThickness="0"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  EnableRowVirtualization="True">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="{DynamicResource GridHeaderFontSize}"/>
                                    <Setter Property="Padding" Value="{DynamicResource GridHeaderPadding}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" SortMemberPath="TimestampTicks" Width="96" MinWidth="78" ElementStyle="{StaticResource RightTabularText}"/>

                                <DataGridTemplateColumn Header="Process" SortMemberPath="ProcessName" Width="180" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,4,0">
                                                <Image Source="{Binding IconSource}" Width="{DynamicResource GridIconSize}" Height="{DynamicResource GridIconSize}" Margin="{DynamicResource GridIconMargin}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Text="{Binding ProcessName}" FontSize="{DynamicResource GridFontSize}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="PID" Binding="{Binding PID}" SortMemberPath="PID" Width="62" MinWidth="52" ElementStyle="{StaticResource RightTabularText}"/>

                                <DataGridTemplateColumn Header="Operation" SortMemberPath="Operation" Width="108" MinWidth="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding OperationBg}" CornerRadius="2" Padding="{DynamicResource GridBadgePadding}" HorizontalAlignment="Left" Margin="4,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Operation}" Foreground="{Binding OperationFg}" FontSize="{DynamicResource GridBadgeFontSize}" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" SortMemberPath="Detail" Width="250" MinWidth="150" ElementStyle="{StaticResource EllipsisCellText}"/>
                                <DataGridTextColumn Header="Rate" Binding="{Binding RateFormatted}" SortMemberPath="RateBps" Width="92" MinWidth="74" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Tree Rate" Binding="{Binding TreeRateFormatted}" SortMemberPath="TreeRateBps" Width="92" MinWidth="74" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Session Total" Binding="{Binding SessionTotalFormatted}" SortMemberPath="SessionBytes" Width="98" MinWidth="82" ElementStyle="{StaticResource RightTabularText}"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="84" MinWidth="68" ElementStyle="{StaticResource EllipsisCellText}"/>
                                <DataGridTextColumn Header="User" Binding="{Binding User}" SortMemberPath="User" Width="*" MinWidth="110" ElementStyle="{StaticResource EllipsisCellText}"/>
                            </DataGrid.Columns>

                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource ContextMenuStyle}">
                                    <MenuItem x:Name="CtxNetTimeFilterProc" Header="Filter to Selected Process"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxNetTimeGoToProcess" Header="Select Process in Tree"/>
                                    <MenuItem x:Name="CtxNetTimePropsTcp" Header="Process Properties (TCP/IP Tab)..." FontWeight="Bold"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxNetTimeCopyDetails" Header="Copy Details"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <!-- Centered Teachable Empty-State Overlay -->
                        <Border x:Name="NetEmptyStateOverlay" Visibility="Collapsed" IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="18,12" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4">
                            <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                                <TextBlock x:Name="TxtNetEmptyTitle" Text="No network rows match your filter" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtNetEmptyHint" Text="Click Refresh or adjust your quick filter chips and search term." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
