                        </DockPanel>
                    </Border>

                    <!-- TCPView-Style Bottom Network Summary Strip -->
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="{DynamicResource SubToolbarPadding}">
