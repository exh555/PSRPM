<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="PSRPM - PowerShell Remote Process Manager"
        Height="780" Width="1280" MinHeight="540" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Dynamic Layout Density Metrics (Standard: 18px/11px/14px; Compact &amp; Mini: 14px/10px/11px + Slim Chrome) -->
        <sys:Double x:Key="GridRowHeight">18</sys:Double>
        <sys:Double x:Key="GridFontSize">11</sys:Double>
        <sys:Double x:Key="GridIconSize">14</sys:Double>
        <sys:Double x:Key="GridFallbackIconSize">11</sys:Double>
        <Thickness x:Key="GridIconMargin">0,0,5,0</Thickness>
        <sys:Double x:Key="ExpanderSlotWidth">16</sys:Double>
        <sys:Double x:Key="ExpanderBoxSize">9</sys:Double>
        <sys:Double x:Key="GridHeaderFontSize">11</sys:Double>
        <Thickness x:Key="GridHeaderPadding">6,3</Thickness>
        <sys:Double x:Key="GridBadgeFontSize">10</sys:Double>
        <Thickness x:Key="GridBadgePadding">5,1</Thickness>
        <Thickness x:Key="SubToolbarPadding">6,3</Thickness>
        <Thickness x:Key="ChipTogglePadding">8,2</Thickness>
        <Thickness x:Key="MainTabStripPadding">4,2,4,0</Thickness>
        <Thickness x:Key="MainTabItemPadding">12,4</Thickness>
        <sys:Double x:Key="MainTabFontSize">11.5</sys:Double>
        <Thickness x:Key="ToolbarBtnPadding">6,4</Thickness>
        <sys:Double x:Key="SearchBoxHeight">26</sys:Double>
        <Visibility x:Key="FullToolbarSparklinesVisibility">Visible</Visibility>
        <Visibility x:Key="CompactToolbarStatsVisibility">Collapsed</Visibility>
        <Visibility x:Key="MainTabHeaderVisibility">Visible</Visibility>
        <sys:Double x:Key="StatusCol0MaxWidth">380</sys:Double>

        <!-- Default Clean Light Theme (Sysinternals Process Explorer Refined) -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushToolbarBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BrushSurfaceBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushHeaderBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushTreeLine" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#475569"/>
        <SolidColorBrush x:Key="BrushRowHover" Color="#220284C7"/>
        <SolidColorBrush x:Key="BrushRowSelectedBg" Color="#006CBE"/>
        <SolidColorBrush x:Key="BrushRowSelectedFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBorder" Color="#94A3B8"/>

        <!-- Menu Theme Brushes (Clean Light Default vs Precision Dark) -->
        <SolidColorBrush x:Key="BrushMenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushMenuBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushMenuHover" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#0369A1"/>
        <SolidColorBrush x:Key="BrushBadgeBg" Color="#0369A1"/>
        <SolidColorBrush x:Key="BrushBadgeFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkGrid" Color="#CBD5E1"/>

        <!-- LogPane & Semantic Action / Swatch Brushes -->
        <SolidColorBrush x:Key="BrushLogBg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushLogHeaderBg" Color="#1E293B"/>
        <SolidColorBrush x:Key="BrushLogBorder" Color="#334155"/>
        <SolidColorBrush x:Key="BrushLogFg" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BrushLogTitleFg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushLogBtnBg" Color="#334155"/>
        <SolidColorBrush x:Key="BrushLogBtnFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushLogTelem1" Color="#38BDF8"/>
        <SolidColorBrush x:Key="BrushLogTelem2" Color="#A7F3D0"/>
        <SolidColorBrush x:Key="BrushLogTelem3" Color="#FDE68A"/>
        <SolidColorBrush x:Key="BrushLogTelem4" Color="#DDD6FE"/>
        <SolidColorBrush x:Key="BrushTargetNodeBg" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="BrushKillBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BrushKillFg" Color="#991B1B"/>
        <SolidColorBrush x:Key="BrushKillBorder" Color="#F87171"/>
        <SolidColorBrush x:Key="BrushKillTreeBg" Color="#FECACA"/>
        <SolidColorBrush x:Key="BrushKillTreeFg" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="BrushKillTreeBorder" Color="#EF4444"/>
        <SolidColorBrush x:Key="BrushSwatchSvcBg" Color="#FFE4E6"/>
        <SolidColorBrush x:Key="BrushSwatchSvcBorder" Color="#FDA4AF"/>
        <SolidColorBrush x:Key="BrushSwatchSvcFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushSwatchOwnBg" Color="#E0E7FF"/>
        <SolidColorBrush x:Key="BrushSwatchOwnBorder" Color="#A5B4FC"/>
        <SolidColorBrush x:Key="BrushSwatchOwnFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushSwatchPkgBg" Color="#67E8F9"/>
        <SolidColorBrush x:Key="BrushSwatchPkgBorder" Color="#06B6D4"/>
        <SolidColorBrush x:Key="BrushSwatchPkgFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushSwatchSuspBg" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushSwatchSuspBorder" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushSwatchSuspFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushSwatchNewBg" Color="#86EFAC"/>
        <SolidColorBrush x:Key="BrushSwatchNewBorder" Color="#22C55E"/>
        <SolidColorBrush x:Key="BrushSwatchNewFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushSwatchExitBg" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="BrushSwatchExitBorder" Color="#EF4444"/>
        <SolidColorBrush x:Key="BrushSwatchExitFg" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushNetRxStroke" Color="#0284C7"/>
        <SolidColorBrush x:Key="BrushNetRxFill" Color="#440284C7"/>
        <SolidColorBrush x:Key="BrushNetTxStroke" Color="#EA580C"/>
        <SolidColorBrush x:Key="BrushNetTxFill" Color="#44EA580C"/>
        <SolidColorBrush x:Key="BrushDeltaGrowthFg" Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrushDeltaShrinkFg" Color="#15803D"/>
        <SolidColorBrush x:Key="BrushDeltaNewFg" Color="#0369A1"/>
        <SolidColorBrush x:Key="BrushBadgeTcpBg" Color="#E0F2FE"/>
        <SolidColorBrush x:Key="BrushBadgeTcpFg" Color="#075985"/>
        <SolidColorBrush x:Key="BrushBadgeUdpBg" Color="#FEF3C7"/>
        <SolidColorBrush x:Key="BrushBadgeUdpFg" Color="#92400E"/>
        <SolidColorBrush x:Key="BrushStateEstBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="BrushStateEstFg" Color="#166534"/>
        <SolidColorBrush x:Key="BrushStateListenBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushStateListenFg" Color="#334155"/>
        <SolidColorBrush x:Key="BrushStateTimeWaitBg" Color="#FFEDD5"/>
        <SolidColorBrush x:Key="BrushStateTimeWaitFg" Color="#9A3412"/>
        <SolidColorBrush x:Key="BrushNetRowNewBg" Color="#DCFCE7"/>
        <SolidColorBrush x:Key="BrushNetRowNewFg" Color="#14532D"/>
        <SolidColorBrush x:Key="BrushNetRowModBg" Color="#FEF08A"/>
        <SolidColorBrush x:Key="BrushNetRowModFg" Color="#713F12"/>
        <SolidColorBrush x:Key="BrushNetRowDelBg" Color="#FEE2E2"/>
        <SolidColorBrush x:Key="BrushNetRowDelFg" Color="#7F1D1D"/>
        <SolidColorBrush x:Key="BrushGaugeCpuFill" Color="#86EFAC"/>
        <SolidColorBrush x:Key="BrushGaugeCpuArea" Color="#8886EFAC"/>
        <SolidColorBrush x:Key="BrushGaugeCpuStroke" Color="#16A34A"/>
        <SolidColorBrush x:Key="BrushGaugeKernelFill" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="BrushGaugeKernelArea" Color="#AAFCA5A5"/>
        <SolidColorBrush x:Key="BrushGaugeKernelStroke" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrushGaugeCommitFill" Color="#D4D47A"/>
        <SolidColorBrush x:Key="BrushGaugeCommitArea" Color="#AAD4D47A"/>
        <SolidColorBrush x:Key="BrushGaugeCommitStroke" Color="#A16207"/>
        <SolidColorBrush x:Key="BrushGaugeRamFill" Color="#FDBA74"/>
        <SolidColorBrush x:Key="BrushGaugeRamArea" Color="#AAFDBA74"/>
        <SolidColorBrush x:Key="BrushGaugeRamStroke" Color="#EA580C"/>
        <SolidColorBrush x:Key="BrushGaugeIoReadFill" Color="#93C5FD"/>
        <SolidColorBrush x:Key="BrushGaugeIoReadArea" Color="#AA93C5FD"/>
        <SolidColorBrush x:Key="BrushGaugeIoReadStroke" Color="#3B82F6"/>
        <SolidColorBrush x:Key="BrushGaugeIoWriteArea" Color="#BBF9A8D4"/>
        <SolidColorBrush x:Key="BrushGaugeIoWriteStroke" Color="#DB2777"/>
        <SolidColorBrush x:Key="BrushMiniCpuFill" Color="#3322C55E"/>
        <SolidColorBrush x:Key="BrushMiniCommitFill" Color="#33EAB308"/>
        <SolidColorBrush x:Key="BrushMiniRamFill" Color="#33F97316"/>
        <SolidColorBrush x:Key="BrushSigSignedFg" Color="#15803D"/>
        <SolidColorBrush x:Key="BrushSigUnsignedFg" Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrushStatusActiveFg" Color="#166534"/>
        <SolidColorBrush x:Key="BrushStatusIdleFg" Color="#475569"/>
        <SolidColorBrush x:Key="BrushStatusExitedFg" Color="#B91C1C"/>
        <SolidColorBrush x:Key="BrushSvcRunningBg" Color="#15803D"/>
        <SolidColorBrush x:Key="BrushSvcPausedBg" Color="#B45309"/>
        <SolidColorBrush x:Key="BrushSvcStoppedBg" Color="#475569"/>

        <!-- Subtle Column Metric Tints (Process Explorer Classic Column Tints) -->
        <SolidColorBrush x:Key="ColTint_CPU" Color="#2222C55E"/>
        <SolidColorBrush x:Key="ColTint_Net" Color="#1A0284C7"/>
        <SolidColorBrush x:Key="ColTint_PrivateBytes" Color="#28EAB308"/>
        <SolidColorBrush x:Key="ColTint_WorkingSet" Color="#22F97316"/>

        <!-- Interactive Toggle Chip / Segmented Mode Button Style -->
        <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{DynamicResource ChipTogglePadding}"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ChipBd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBd" Property="Background" Value="{DynamicResource BrushTargetNodeBg}"/>
                                <Setter TargetName="ChipBd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Selection-Safe Delta Styles (Setter foreground is overridden when DataGridRow.IsSelected is True) -->
        <Style x:Key="CpuDeltaTabularStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{Binding CPUDeltaSolidBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrivateDeltaTabularStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{Binding PrivateDeltaSolidBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WsDeltaTabularStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{Binding MemoryDeltaSolidBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrivateDeltaBadgeStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{Binding PrivateDeltaSolidBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WsDeltaBadgeStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="Foreground" Value="{Binding MemoryDeltaSolidBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Toolbar Button Style with Complete Interactive States -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="{DynamicResource ToolbarBtnPadding}"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-Aligned Tabular Numeric TextBlock Style -->
        <Style x:Key="RightTabularText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
        </Style>

        <!-- Single-Line Truncated Text Cell Style -->
        <Style x:Key="EllipsisCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
        </Style>

        <!-- Modern Global DataGridColumnHeader Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="{DynamicResource GridHeaderFontSize}"/>
            <Setter Property="Padding" Value="{DynamicResource GridHeaderPadding}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- Modern Global TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Visibility="{DynamicResource MainTabHeaderVisibility}" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="{DynamicResource MainTabStripPadding}">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Segmented Workspace TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="{DynamicResource MainTabItemPadding}"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="{DynamicResource MainTabFontSize}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="{DynamicResource MainTabFontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter TargetName="HeaderContent" Property="TextElement.FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu &amp; ContextMenu Separator Style -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="Margin" Value="24,4,4,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-Level Menu Header Template (File, Options, View, Process, Help) -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="7,3" Margin="1,0">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom" PopupAnimation="Fade" VerticalOffset="1">
                        <Border Background="{DynamicResource BrushMenuBg}"
                                BorderBrush="{DynamicResource BrushMenuBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="2">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                </MultiTrigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Top-Level Menu Item Template (Standalone Action on Menu Bar) -->
        <ControlTemplate x:Key="TopLevelItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="7,3" Margin="1,0">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dropdown &amp; Context Submenu Item Template -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="2,4" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" SharedSizeGroup="MenuItemIconColumnGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Checkmark" Grid.Column="0"
                          Data="M 2.5,6.5 L 5.5,9.5 L 11.5,3.5"
                          Stroke="{DynamicResource BrushTextPrimary}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                    <Ellipse x:Name="RadioDot" Grid.Column="0"
                             Width="6" Height="6"
                             Fill="{DynamicResource BrushTextPrimary}"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                    <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontWeight="Normal" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,4,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsChecked" Value="True"/>
                        <Condition Property="Tag" Value="Radio"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="RadioDot" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                    <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="Checkmark" Property="Stroke" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="RadioDot" Property="Fill" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="GestureText" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Nested Dropdown Submenu Header Template (Update Speed, Set Priority) -->
        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="2,4" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" SharedSizeGroup="MenuItemIconColumnGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Checkmark" Grid.Column="0"
                          Data="M 2.5,6.5 L 5.5,9.5 L 11.5,3.5"
                          Stroke="{DynamicResource BrushTextPrimary}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                    <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontWeight="Normal" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,4,0"/>
                    <Path x:Name="Arrow" Grid.Column="3" Data="M 0,0 L 4,3.5 L 0,7 Z" Fill="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Right" HorizontalOffset="-2" VerticalOffset="-2" PopupAnimation="Fade">
                        <Border Background="{DynamicResource BrushMenuBg}"
                                BorderBrush="{DynamicResource BrushMenuBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="2">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BrushTextPrimary}"/>
                    <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                </MultiTrigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BrushTextPrimary}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="GestureText" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Unified MenuItem Style routing by Role -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean ContextMenu Flyout Style -->
        <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BrushMenuBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource ContextMenuStyle}"/>

        <!-- Clean Modern Theme-Aware ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel x:Name="RootLayoutPanel">
        <DockPanel.LayoutTransform>
            <ScaleTransform x:Name="RootScaleTransform" ScaleX="1" ScaleY="1"/>
        </DockPanel.LayoutTransform>
        <!-- 1. Classic Sysinternals Menu Bar -->
        <Menu x:Name="MainMenuBar" DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderBg}" Foreground="{DynamicResource BrushTextPrimary}" Padding="2,1" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <MenuItem x:Name="MenuFile" Header="_File">
                <MenuItem x:Name="MenuConnectHost" Header="_Connect / Switch Host..." InputGestureText="Ctrl+K" FontWeight="SemiBold"/>
                <MenuItem x:Name="MenuNewHostTab" Header="New _Host Session Tab..." InputGestureText="Ctrl+Shift+K"/>
                <MenuItem x:Name="MenuReconnectHost" Header="_Reconnect Active Host" IsEnabled="False" ToolTip="Retry the WinRM connection for the active remote host tab"/>
                <MenuItem x:Name="MenuSwitchLocal" Header="Switch to _Local Machine"/>
                <Separator/>
                <MenuItem x:Name="MenuNextHostTab" Header="_Next Host Tab" InputGestureText="Ctrl+Tab"/>
                <MenuItem x:Name="MenuPrevHostTab" Header="Pre_vious Host Tab" InputGestureText="Ctrl+Shift+Tab"/>
                <MenuItem x:Name="MenuCloseHostTab" Header="Close Current Host _Tab" InputGestureText="Ctrl+W"/>
                <Separator/>
                <MenuItem x:Name="MenuExportCsv" Header="_Export Process Snapshot (CSV)..." InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MenuExportJson" Header="Export Forensic Snapshot (_JSON)..."/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="E_xit" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem x:Name="MenuOptions" Header="_Options">
                <MenuItem x:Name="MenuAlwaysOnTop" Header="Always _On Top" InputGestureText="Ctrl+Shift+T" IsCheckable="True" ToolTip="Keep PSRPM main window and dialogs above all other desktop windows (Ctrl+Shift+T)"/>
                <Separator/>
                <MenuItem Header="_Theme">
                    <MenuItem x:Name="MenuThemeCycle" Header="Cycle _Next Theme" InputGestureText="Ctrl+D"/>
                    <Separator/>
                    <MenuItem x:Name="MenuThemeLight" Header="_Clean Light Theme (Sysinternals)" IsCheckable="True" IsChecked="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuThemeDark" Header="_Precision Dark Theme" IsCheckable="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuThemeTokyoNight" Header="_Tokyo Night (Dark)" IsCheckable="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuThemeTokyoNightLight" Header="Tokyo Night _Light" IsCheckable="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuThemeClassic" Header="_Sysinternals Classic (Win32 Retro)" IsCheckable="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuThemeHighContrast" Header="_High-Contrast Monochrome (WCAG AAA)" IsCheckable="True" Tag="Radio"/>
                </MenuItem>
                <MenuItem x:Name="MenuHighlightCategories" Header="_Highlight Process Categories" IsCheckable="True" IsChecked="True" ToolTip="Toggle static category row colors (Services, User, Packaged, Suspended) while preserving dynamic New (Green) and Exiting (Red) flashes"/>
                <Separator/>
                <MenuItem x:Name="MenuConfirmKill" Header="Confirm _Kill Process Actions" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="MenuVerboseTelemetry" Header="Log _Verbose Telemetry" IsCheckable="True" IsChecked="True" ToolTip="Stream per-tick telemetry diagnostics to the Activity &amp; Audit Log Pane"/>
                <Separator/>
                <MenuItem x:Name="MenuSavePreferences" Header="_Save Preferences as Default" ToolTip="Opt-in: Save current theme, columns, sort/view mode, log console state, and options to %LOCALAPPDATA%\PSRPM\preferences.json (never auto-saved on exit)"/>
                <MenuItem x:Name="MenuResetPreferences" Header="_Reset Preferences to Defaults" ToolTip="Delete saved %LOCALAPPDATA%\PSRPM\preferences.json and restore built-in defaults (preferences are never auto-saved on exit)"/>
            </MenuItem>
            <MenuItem x:Name="MenuView" Header="_View">
                <MenuItem x:Name="MenuRefresh" Header="_Refresh Now" InputGestureText="F5"/>
                <MenuItem x:Name="MenuSystemInfo" Header="_System Information..." InputGestureText="Ctrl+I" FontWeight="SemiBold"/>
                <MenuItem Header="_Update Speed">
                    <MenuItem x:Name="MenuRate500ms" Header="_High (500 ms)" IsCheckable="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuRate1s" Header="_Normal (1 second)" IsCheckable="True" IsChecked="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuRate2s" Header="_Standard (2 seconds)" IsCheckable="True" Tag="Radio"/>
                    <MenuItem x:Name="MenuRate5s" Header="_Low (5 seconds)" IsCheckable="True" Tag="Radio"/>
                    <Separator/>
                    <MenuItem x:Name="MenuRatePaused" Header="_Paused" InputGestureText="Space" IsCheckable="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuViewTree" Header="Show Process _Tree" InputGestureText="Ctrl+T" IsCheckable="True" IsChecked="True" ToolTip="Toggle between Hierarchical Process Tree and Flat List view (Ctrl+T)"/>
                <MenuItem x:Name="MenuViewTreeLines" Header="Show Tree _Lines" IsCheckable="True" IsChecked="True" ToolTip="Show or hide tree connector lines in Process Tree view"/>
                <MenuItem x:Name="MenuTreeOptions" Header="Tree _Options">
                    <MenuItem x:Name="MenuTreeOrderNewest" Header="Order: _Newest First (Creation Time)" IsCheckable="True" IsChecked="True" Tag="Radio" ToolTip="Order root processes and sibling children newest-first by creation time"/>
                    <MenuItem x:Name="MenuTreeOrderClassic" Header="Order: _Classic Process Explorer (Oldest First)" IsCheckable="True" Tag="Radio" ToolTip="Order root processes and sibling children in classic Process Explorer order"/>
                    <Separator/>
                    <MenuItem x:Name="MenuExpandAll" Header="_Expand All Tree Nodes"/>
                    <MenuItem x:Name="MenuCollapseAll" Header="C_ollapse All Tree Nodes"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuViewSelectColumns" Header="Select _Columns..." FontWeight="SemiBold"/>
                <MenuItem x:Name="MenuViewBaseline" Header="Capture Process _Baseline" InputGestureText="Ctrl+B" ToolTip="Capture or refresh Private Bytes, Working Set, and Handles baseline to highlight growth and new processes (Ctrl+B)"/>
                <MenuItem x:Name="MenuViewClearBaseline" Header="Clear Bas_eline" InputGestureText="Ctrl+Shift+B" IsEnabled="False" ToolTip="Clear the active process baseline snapshot for the current host tab (Ctrl+Shift+B)"/>
                <Separator/>
                <MenuItem x:Name="MenuNetEtwGroup" Header="_Network Monitoring (ETW)">
                    <MenuItem x:Name="MenuViewNetEtw" Header="_Enable Per-Process Network ETW" InputGestureText="Ctrl+Shift+N" IsCheckable="True"/>
                    <Separator/>
                    <MenuItem x:Name="MenuColTreeNet" Header="Show _Tree Net Column" IsCheckable="True" IsChecked="True" IsEnabled="False"/>
                    <MenuItem x:Name="MenuColNetRxTx" Header="Show Net _Recv / Send Columns" IsCheckable="True" IsEnabled="False"/>
                </MenuItem>
                <MenuItem x:Name="MenuViewLog" Header="_Activity &amp; Audit Log Pane" InputGestureText="Ctrl+L" IsCheckable="True"/>
                <MenuItem x:Name="MenuDisplayDensity" Header="_Display &amp; Scale">
                    <MenuItem x:Name="MenuLayoutStandard" Header="_Standard" IsCheckable="True" IsChecked="True" Tag="Radio" ToolTip="Standard layout with 18 px rows and full sparkline toolbar"/>
                    <MenuItem x:Name="MenuLayoutCompact" Header="_Compact Density" InputGestureText="Ctrl+Shift+C" IsCheckable="True" Tag="Radio" ToolTip="Ultra-compact 14 px rows, slim toolbar and headers, and auto-hidden single-host tab strip (Ctrl+Shift+C)"/>
                    <MenuItem x:Name="MenuLayoutMini" Header="_Mini Monitor" InputGestureText="Ctrl+Shift+M" IsCheckable="True" Tag="Radio" ToolTip="Chromeless Always-On-Top side widget with 14 px rows and focused Process / CPU / Private / PID columns (Ctrl+Shift+M)"/>
                    <Separator/>
                    <MenuItem x:Name="MenuUiScale" Header="UI _Zoom">
                        <MenuItem x:Name="MenuScaleZoomIn" Header="Zoom _In" InputGestureText="Ctrl++"/>
                        <MenuItem x:Name="MenuScaleZoomOut" Header="Zoom _Out" InputGestureText="Ctrl+-"/>
                        <MenuItem x:Name="MenuScaleReset" Header="_Reset Zoom (100%)" InputGestureText="Ctrl+0"/>
                        <Separator/>
                        <MenuItem x:Name="MenuScale75" Header="75%" IsCheckable="True" Tag="Radio"/>
                        <MenuItem x:Name="MenuScale100" Header="100% (Default)" IsCheckable="True" IsChecked="True" Tag="Radio"/>
                        <MenuItem x:Name="MenuScale125" Header="125%" IsCheckable="True" Tag="Radio"/>
                        <MenuItem x:Name="MenuScale150" Header="150%" IsCheckable="True" Tag="Radio"/>
                        <MenuItem x:Name="MenuScale175" Header="175%" IsCheckable="True" Tag="Radio"/>
                        <MenuItem x:Name="MenuScale200" Header="200%" IsCheckable="True" Tag="Radio"/>
                    </MenuItem>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="MenuProcess" Header="_Process">
                <MenuItem x:Name="MenuProperties" Header="_Properties..." InputGestureText="Enter" FontWeight="SemiBold"/>
                <MenuItem x:Name="MenuGoToParent" Header="Go to P_arent Process" ToolTip="Jump selection to the parent process that spawned the selected process"/>
                <Separator/>
                <MenuItem x:Name="MenuSuspend" Header="_Suspend Process"/>
                <MenuItem x:Name="MenuResume" Header="R_esume Process"/>
                <MenuItem x:Name="MenuSetPriority" Header="Set Pr_iority">
                    <MenuItem x:Name="MenuPrioIdle" Header="_Idle (Low)"/>
                    <MenuItem x:Name="MenuPrioBelow" Header="_Below Normal"/>
                    <MenuItem x:Name="MenuPrioNormal" Header="_Normal"/>
                    <MenuItem x:Name="MenuPrioAbove" Header="_Above Normal"/>
                    <MenuItem x:Name="MenuPrioHigh" Header="_High"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuEndProcess" Header="_Kill Process" InputGestureText="Del"/>
                <MenuItem x:Name="MenuEndProcessTree" Header="Kill Process _Tree" InputGestureText="Shift+Del"/>
                <Separator/>
                <MenuItem x:Name="MenuCreateDump" Header="Create _Dump">
                    <MenuItem x:Name="MenuCreateMiniDump" Header="Create _Minidump..." ToolTip="Create lightweight minidump on target host in %SystemRoot%\Temp\PSRPM_Dumps (or %LOCALAPPDATA%\PSRPM\Dumps)"/>
                    <MenuItem x:Name="MenuCreateFullDump" Header="Create _Full Memory Dump..." ToolTip="Create complete memory dump on target host in %SystemRoot%\Temp\PSRPM_Dumps (or %LOCALAPPDATA%\PSRPM\Dumps)"/>
                </MenuItem>
                <MenuItem x:Name="MenuCopySubmenu" Header="_Copy">
                    <MenuItem x:Name="MenuCopyName" Header="Copy Process _Name"/>
                    <MenuItem x:Name="MenuCopyPid" Header="Copy _PID"/>
                    <Separator/>
                    <MenuItem x:Name="MenuCopyCmdLine" Header="Copy _Command Line"/>
                    <MenuItem x:Name="MenuCopyPath" Header="Copy _Executable Path"/>
                </MenuItem>
            </MenuItem>
            <MenuItem x:Name="MenuFind" Header="_Find">
                <MenuItem x:Name="MenuFindFilter" Header="_Filter Active Tab..." InputGestureText="Ctrl+F" ToolTip="Focus the search filter box for the active workspace tab (Ctrl+F)"/>
                <MenuItem x:Name="MenuFindClearFilter" Header="_Clear Active Filter" InputGestureText="Esc" IsEnabled="False" ToolTip="Clear the active search or category filter on the current tab (Esc)"/>
                <Separator/>
                <MenuItem x:Name="MenuFindHandle" Header="Find _Handle or DLL..." InputGestureText="Ctrl+Shift+F" FontWeight="SemiBold"/>
            </MenuItem>
            <MenuItem x:Name="MenuHelp" Header="_Help">
                <MenuItem x:Name="MenuHelpTopics" Header="_Keyboard Shortcuts &amp; Reference..." InputGestureText="F1" FontWeight="SemiBold"/>
                <MenuItem x:Name="MenuHelpArchitecture" Header="_Architecture &amp; Safety Overview..."/>
                <MenuItem x:Name="MenuHelpConnectivity" Header="_Remoting &amp; Connectivity Guide..."/>
                <Separator/>
                <MenuItem x:Name="MenuHelpAbout" Header="A_bout PSRPM..."/>
            </MenuItem>
        </Menu>

        <!-- 1B. Multi-Host Tabbed Session Strip -->
        <Border x:Name="HostTabBar" DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,4,6,0">
            <DockPanel>
                <Button x:Name="BtnAddHostTab" DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" Margin="4,0,2,2" ToolTip="Connect to Another Remote Host or Local (Ctrl+Shift+K)" Cursor="Hand" AutomationProperties.Name="Connect Another Host Session">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,-2,3,0"/>
                        <TextBlock Text="Add Host" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="Transparent">
                    <ItemsControl x:Name="HostTabsList" Background="Transparent">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabItemBorder" Background="{Binding TabBackgroundBrush}" BorderBrush="{Binding TabBorderSolidBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,3,6,3" Margin="0,0,4,0" Cursor="Hand" ToolTip="{Binding ComputerName}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding StatusDotFillBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleForegroundBrush}" FontWeight="{Binding TitleWeight}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Grid.Column="2" Background="{Binding BadgeBackgroundBrush}" CornerRadius="2" Padding="3,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Transport}" Foreground="{DynamicResource BrushBadgeFg}" FontSize="8.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding LatencyText}" Foreground="{DynamicResource BrushTextMuted}" FontSize="9.5" Margin="0,0,5,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                        <Button Grid.Column="4" x:Name="BtnCloseHostTab" Content="X" Width="14" Height="14" FontSize="9.5" FontWeight="Bold" Padding="0,-2,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextMuted}" Visibility="{Binding CloseVis}" ToolTip="Close Session Tab (Ctrl+W)" Cursor="Hand" AutomationProperties.Name="Close Host Session Tab"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 1C. Mini Monitor Chromeless HUD Strip (Visible Only in Mini Monitor Mode, Ctrl+Shift+M) -->
        <Border x:Name="MiniMonitorBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,2">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Height="20" Width="84" Margin="0,0,4,0">
                        <DockPanel>
                            <Button x:Name="BtnClearMiniSearch" DockPanel.Dock="Right" Content="X" AutomationProperties.Name="Clear Mini Monitor Filter" Width="15" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" Visibility="Collapsed" ToolTip="Clear Filter (Esc)"/>
                            <TextBox x:Name="TxtMiniSearch" AutomationProperties.Name="Mini Monitor Filter Processes" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" FontSize="10.5" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Filter processes (Ctrl+F / Esc)"/>
                        </DockPanel>
                    </Border>
                    <Button x:Name="BtnMiniPause" Content="Pause" AutomationProperties.Name="Pause or Resume Mini Monitor Polling" Style="{StaticResource ToolbarButtonStyle}" FontSize="10" Padding="5,1" Margin="0,0,2,0" ToolTip="Pause or Resume Polling (Space)"/>
                    <Button x:Name="BtnExitMiniMonitor" Content="Exit Mini" AutomationProperties.Name="Exit Mini Monitor Mode" Style="{StaticResource ToolbarButtonStyle}" FontSize="10" FontWeight="SemiBold" Padding="5,1" ToolTip="Restore Full PSRPM Workspace (Ctrl+Shift+M)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="MiniStatusDot" Width="7" Height="7" Fill="#16A34A" Margin="0,0,4,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtMiniHostName" Text="LOCALHOST" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" TextTrimming="CharacterEllipsis" MaxWidth="100"/>
                    <TextBlock Text="CPU " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CpuSummaryFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="RAM " FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RamPctFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="{Binding ProcessCount}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                    <TextBlock Text="p" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 2. Unified Command, Connection Badge & Real-Time Sparkline Telemetry Strip -->
        <Border x:Name="SummaryBar" DockPanel.Dock="Top" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: Responsive Wrap Zone (Action Toolbar + Mini Sparkline Telemetry Strip wrap gracefully on narrow viewports) -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Legacy Target Connection Badge (Collapsed: HostTabBar provides host session management) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,8,1" Visibility="Collapsed">
                        <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnStatusDot" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTargetBadge" Text="LOCALHOST" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BrushBadgeBg}" CornerRadius="2" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTransportBadge" Text="WINRM" Foreground="{DynamicResource BrushBadgeFg}" FontSize="9" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="TxtLatencyBadge" Text="0 ms" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                        <Button x:Name="BtnConnectHost" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Connect / Switch Remote Target (Ctrl+K)" AutomationProperties.Name="Connect or Switch Target Host" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z" Fill="{DynamicResource BrushAccent}" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock Text="Connect" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Sysinternals Quick Action Vector Toolbar -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,10,1">
                        <Button x:Name="BtnToolbarRefresh" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Refresh Now (F5)" AutomationProperties.Name="Refresh Process List">
                            <Path Data="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6c0,1.01-0.25,1.97-0.7,2.8l1.46,1.46C19.54,15.03,20,13.57,20,12C20,7.58,16.42,4,12,4z M12,18c-3.31,0-6-2.69-6-6c0-1.01,0.25-1.97,0.7-2.8L5.24,7.74C4.46,8.97,4,10.43,4,12c0,4.42,3.58,8,8,8v3l4-4l-4-4V18z" Fill="{DynamicResource BrushAccent}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnToolbarPause" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Pause Polling (Space)" AutomationProperties.Name="Pause or Resume Telemetry Polling">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="IconToolbarPause" Data="M6,19h4V5H6V19z M14,5v14h4V5H14z" Fill="{DynamicResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock x:Name="TxtToolbarPause" Text="" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                        <Button x:Name="BtnToolbarTree" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Toggle Process Tree / Flat View (Ctrl+T)" AutomationProperties.Name="Toggle Process Tree or Flat View">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3,3h6v4H3V3z M7,7v5h4v-2h6v4h-6v-2H7v6h4v-2h6v4h-6v-2H5V7H3z" Fill="{DynamicResource BrushStatusActiveFg}" Width="15" Height="15" Stretch="Uniform"/>
                                <TextBlock x:Name="TxtModeIndicator" Text="Tree (New)" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnToolbarProps" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Inspect Process Properties (Enter)" AutomationProperties.Name="Inspect Selected Process Properties">
                            <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-6h2V17z M13,9h-2V7h2V9z" Fill="{DynamicResource BrushAccent}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnToolbarKill" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Kill Selected Process(es) (Del)" AutomationProperties.Name="Kill Selected Process">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41z" Fill="{DynamicResource BrushKillFg}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="BtnToolbarKillTree" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Kill Process Tree(s) (Shift+Del)" AutomationProperties.Name="Kill Selected Process Tree">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41z" Fill="{DynamicResource BrushKillFg}" Width="14" Height="14" Stretch="Uniform"/>
                                <TextBlock Text="Tree" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushKillFg}" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                        <Button x:Name="BtnFindHandleOrDll" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Find Handle or DLL Substring (Ctrl+Shift+F)" AutomationProperties.Name="Find Handle or Loaded DLL">
                            <Path Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14Z" Fill="{DynamicResource BrushAccent}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                        <Button x:Name="BtnToolbarNetEtw" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Toggle Opt-In Per-Process Kernel Network Monitoring (ETW, Ctrl+Shift+N)" AutomationProperties.Name="Toggle Kernel Network ETW Monitoring">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="EllNetEtwDot" Width="7" Height="7" Fill="#94A3B8" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNetEtwBtn" Text="Net ETW" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnToolbarNetRxTx" Style="{StaticResource ToolbarButtonStyle}" Visibility="Collapsed" ToolTip="Show/Hide Net Recv and Net Send Split Columns" Margin="1,0,0,0" AutomationProperties.Name="Toggle Net Receive and Send Columns">
                            <TextBlock Text="Rx/Tx" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                        </Button>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                        <Button x:Name="BtnToolbarTheme" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Cycle Theme: Clean Light / Dark / Tokyo Night / Tokyo Night Light / Classic / High-Contrast (Ctrl+D)" AutomationProperties.Name="Cycle Color Theme">
                            <TextBlock x:Name="TxtThemeToggle" Text="Dark Mode" FontSize="11" FontWeight="SemiBold"/>
                        </Button>
                        <Button x:Name="BtnToolbarHelp" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Help, Keyboard Shortcuts &amp; About (F1)" Margin="2,0,0,0" AutomationProperties.Name="Open Help and Shortcuts">
                            <Path Data="M11,18h2v-2h-2V18z M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z M12,6c-2.21,0-4,1.79-4,4h2c0-1.1,0.9-2,2-2s2,0.9,2,2c0,2-3,1.75-3,5h2c0-2.25,3-2.5,3-5C16,7.79,14.21,6,12,6z" Fill="{DynamicResource BrushAccent}" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <Border x:Name="BadgeBaselineActive" Visibility="Collapsed" Background="{DynamicResource BrushTargetNodeBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="3" Padding="5,1" Margin="4,0,0,0" VerticalAlignment="Center" ToolTip="Process baseline snapshot active for current host tab (Ctrl+B to update)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtBaselineLabel" Text="Baseline 00:00" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                <Button x:Name="BtnClearBaseline" Content="X" FontSize="9" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource BrushAccent}" BorderThickness="0" Padding="4,0,1,0" Margin="2,0,0,0" Cursor="Hand" ToolTip="Clear active baseline" AutomationProperties.Name="Clear Process Baseline"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sysinternals Mini Telemetry Sparkline Strip (Standard Mode; Double-Click for System Information) -->
                    <StackPanel x:Name="FullToolbarSparklines" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,1,4,1" Visibility="{DynamicResource FullToolbarSparklinesVisibility}">
                        <!-- CPU Sparkline Box -->
                        <Border x:Name="CardMiniCpu" CornerRadius="4" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" Background="{DynamicResource BrushSparkBg}" Margin="0,0,4,0" Cursor="Hand" ToolTipService.IsEnabled="False" AutomationProperties.Name="CPU Utilization Mini Sparkline">
                            <Grid x:Name="GridMiniCpu" Width="82" Height="26" ClipToBounds="True" Background="Transparent">
                                <Polygon Points="{Binding CpuFillPointCollection}" Fill="{DynamicResource BrushMiniCpuFill}" IsHitTestVisible="False"/>
                                <Polyline Points="{Binding CpuPointCollection}" Stroke="{DynamicResource BrushGaugeCpuStroke}" StrokeThickness="1.3" IsHitTestVisible="False"/>
                                <Line x:Name="CrosshairMiniCpu" X1="0" Y1="0" X2="0" Y2="26" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="CPU" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtCpuSummary" Text="{Binding CpuSummaryFormatted}" FontSize="10" FontWeight="SemiBold" Margin="0,1,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Commit Charge Sparkline Box -->
                        <Border x:Name="CardMiniCommit" CornerRadius="4" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" Background="{DynamicResource BrushSparkBg}" Margin="0,0,4,0" Cursor="Hand" ToolTipService.IsEnabled="False" AutomationProperties.Name="Commit Charge Mini Sparkline">
                            <Grid x:Name="GridMiniCommit" Width="86" Height="26" ClipToBounds="True" Background="Transparent">
                                <Polygon Points="{Binding CommitFillPointCollection}" Fill="{DynamicResource BrushMiniCommitFill}" IsHitTestVisible="False"/>
                                <Polyline Points="{Binding CommitPointCollection}" Stroke="{DynamicResource BrushGaugeCommitStroke}" StrokeThickness="1.3" IsHitTestVisible="False"/>
                                <Line x:Name="CrosshairMiniCommit" X1="0" Y1="0" X2="0" Y2="26" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="Commit" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtCommitSummary" Text="{Binding CommitSummaryFormatted}" FontSize="10" FontWeight="SemiBold" Margin="0,1,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Physical RAM Sparkline Box -->
                        <Border x:Name="CardMiniRam" CornerRadius="4" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" Background="{DynamicResource BrushSparkBg}" Margin="0,0,6,0" Cursor="Hand" ToolTipService.IsEnabled="False" AutomationProperties.Name="Physical RAM Mini Sparkline">
                            <Grid x:Name="GridMiniRam" Width="92" Height="26" ClipToBounds="True" Background="Transparent">
                                <Polygon Points="{Binding RamFillPointCollection}" Fill="{DynamicResource BrushMiniRamFill}" IsHitTestVisible="False"/>
                                <Polyline Points="{Binding RamPointCollection}" Stroke="{DynamicResource BrushGaugeRamStroke}" StrokeThickness="1.3" IsHitTestVisible="False"/>
                                <Line x:Name="CrosshairMiniRam" X1="0" Y1="0" X2="0" Y2="26" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                <TextBlock Text="Phys RAM" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                <TextBlock x:Name="TxtRamSummary" Text="{Binding RamPctFormatted}" FontSize="10" FontWeight="SemiBold" Margin="0,1,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Compact System Totals (2-Line Stack Prevents Horizontal Clipping) -->
                        <StackPanel VerticalAlignment="Center" Margin="2,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Procs: " Foreground="{DynamicResource BrushTextMuted}" FontSize="10"/>
                                <TextBlock x:Name="TxtProcCount" Text="{Binding ProcessCount}" FontWeight="SemiBold" FontSize="10" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="Handles: " Foreground="{DynamicResource BrushTextMuted}" FontSize="10"/>
                                <TextBlock x:Name="TxtHandleCount" Text="{Binding HandleCount}" FontWeight="SemiBold" FontSize="10" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Live Hardware Throughput (Network & Storage) Tabular Pill -->
                        <Border x:Name="BorderTelemNetRate" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="3,0,0,0" VerticalAlignment="Center" Cursor="Hand" ToolTip="Real-Time Network &amp; Storage Throughput (Double-click to open System Information - Network)" AutomationProperties.Name="Network and Storage Throughput">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTelemNetRate" Text="{Binding NetThroughputFormatted}" Foreground="{DynamicResource BrushAccent}" FontSize="9.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" ToolTip="Real-Time Network Interface Throughput (Rx / Tx - Double-click for Network Graph)"/>
                                <TextBlock x:Name="TxtTelemDiskRate" Text="{Binding DiskActivityFormatted}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9.5" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0" ToolTip="Real-Time Storage &amp; System I/O Activity (Throughput &amp; IOPS)"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Slim Single-Line Telemetry Pills (Compact Mode; Double-Click for System Information) -->
                    <StackPanel x:Name="CompactToolbarStats" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{DynamicResource CompactToolbarStatsVisibility}">
                        <Border x:Name="CompactStatCpu" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,3,0" Cursor="Hand" ToolTip="CPU Utilization (Double-click for System Information - CPU)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CPU " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding CpuSummaryFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CompactStatCommit" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,3,0" Cursor="Hand" ToolTip="Commit Charge (Double-click for System Information - Memory)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Commit " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding CommitSummaryFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="CompactStatRam" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,3,0" Cursor="Hand" ToolTip="Physical RAM (Double-click for System Information - Memory)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="RAM " FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock Text="{Binding RamPctFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,3,0" ToolTip="Live Process and Handle Totals">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding ProcessCount}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock Text="p" FontSize="10" Foreground="{DynamicResource BrushTextMuted}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </WrapPanel>

                <!-- Col 1: Right-Docked Instant Search / Filter Box -->
                <Border Grid.Column="1" Width="194" MinWidth="150" MaxWidth="250" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center" Height="{DynamicResource SearchBoxHeight}" Margin="6,0,0,0">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"
                              Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="6,0,2,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearSearch" DockPanel.Dock="Right" Content="X" Width="20" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" ToolTip="Clear Filter (Esc)" AutomationProperties.Name="Clear Process Filter"/>
                        <TextBlock x:Name="TxtMatchCount" DockPanel.Dock="Right" Text="" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="2,0,4,0" Typography.NumeralAlignment="Tabular"/>
                        <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Filter by Process Name, PID, Description, Company, User, or Service (Ctrl+F)" AutomationProperties.Name="Filter Processes"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Bottom Status Bar & Interactive Semantic Color Legend -->
        <StatusBar x:Name="MainStatusBar" DockPanel.Dock="Bottom" Background="{DynamicResource BrushHeaderBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="{DynamicResource StatusCol0MaxWidth}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <!-- Col 0: Left Elastic Telemetry Section -->
            <StatusBarItem Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgePaused" Background="#F59E0B" CornerRadius="2" Padding="5,1" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="PAUSED" Foreground="#0F172A" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Initializing Telemetry Engine..." FontSize="11" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" ToolTip="Target Telemetry &amp; Status (Full string preserved on hover)"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Col 1: Center Scrollable Legend with Auto-Overflow -->
            <StatusBarItem Grid.Column="1" HorizontalContentAlignment="Stretch">
                <ScrollViewer x:Name="ScrollStatusLegend" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PanningMode="HorizontalOnly" VerticalAlignment="Center" Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                        <TextBlock x:Name="TxtFilterLegendLabel" Text="Filter:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnLegendAll" Content="All" AutomationProperties.Name="Filter All Process Categories" FontSize="10" FontWeight="SemiBold" Padding="5,1" Margin="0,0,3,0" Background="{DynamicResource BrushHeaderBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="2" Cursor="Hand" ToolTip="Show All Process Categories"/>
                        <Button x:Name="BtnLegendService" Content="Services" AutomationProperties.Name="Filter Service Processes" FontSize="10" Padding="5,1" Margin="0,0,3,0" Background="{DynamicResource BrushSwatchSvcBg}" Foreground="{DynamicResource BrushSwatchSvcFg}" BorderBrush="{DynamicResource BrushSwatchSvcBorder}" BorderThickness="1" Cursor="Hand" ToolTip="Filter Service Processes (Click to toggle)"/>
                        <Button x:Name="BtnLegendOwn" Content="Own / User" AutomationProperties.Name="Filter Own User Processes" FontSize="10" Padding="5,1" Margin="0,0,3,0" Background="{DynamicResource BrushSwatchOwnBg}" Foreground="{DynamicResource BrushSwatchOwnFg}" BorderBrush="{DynamicResource BrushSwatchOwnBorder}" BorderThickness="1" Cursor="Hand" ToolTip="Filter User Session Processes (Click to toggle)"/>
                        <Button x:Name="BtnLegendPackaged" Content="Packaged" AutomationProperties.Name="Filter Packaged Processes" FontSize="10" Padding="5,1" Margin="0,0,3,0" Background="{DynamicResource BrushSwatchPkgBg}" Foreground="{DynamicResource BrushSwatchPkgFg}" BorderBrush="{DynamicResource BrushSwatchPkgBorder}" BorderThickness="1" Cursor="Hand" ToolTip="Filter Packaged / WebView2 Processes (Click to toggle)"/>
                        <Button x:Name="BtnLegendClear" Content="Clear Filter" AutomationProperties.Name="Clear Process Category Filter" FontSize="9" FontWeight="Bold" Padding="4,1" Margin="1,0,4,0" Background="{DynamicResource BrushKillBg}" Foreground="{DynamicResource BrushKillFg}" BorderBrush="{DynamicResource BrushKillBorder}" BorderThickness="1" Cursor="Hand" Visibility="Collapsed" ToolTip="Clear active category filter and show all processes"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                        <TextBlock Text="Lifecycle:" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushSwatchSuspBg}" BorderBrush="{DynamicResource BrushSwatchSuspBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,3,0">
                            <TextBlock Text="Suspended" Foreground="{DynamicResource BrushSwatchSuspFg}" FontSize="10"/>
                        </Border>
                        <Border Background="{DynamicResource BrushSwatchNewBg}" BorderBrush="{DynamicResource BrushSwatchNewBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,3,0">
                            <TextBlock Text="New" Foreground="{DynamicResource BrushSwatchNewFg}" FontSize="10"/>
                        </Border>
                        <Border Background="{DynamicResource BrushSwatchExitBg}" BorderBrush="{DynamicResource BrushSwatchExitBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1">
                            <TextBlock Text="Exiting" Foreground="{DynamicResource BrushSwatchExitFg}" FontSize="10"/>
                        </Border>
                        <Button x:Name="BtnToggleHighlights" Content="Colors: Standard" AutomationProperties.Name="Toggle Process Category Highlight Colors" FontSize="9.5" FontWeight="SemiBold" Padding="5,1" Margin="5,0,0,0" Background="{DynamicResource BrushToolbarBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Cursor="Hand" ToolTip="Toggle static category coloring on/off (New &amp; Exiting flashes remain active)"/>
                    </StackPanel>
                </ScrollViewer>
            </StatusBarItem>

            <!-- Col 2: Right Pinned Actions & Overflow Indicator (Always Visible) -->
            <StatusBarItem Grid.Column="2">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStatusOverflow" Content="&gt;&gt; More" Style="{StaticResource ToolbarButtonStyle}" FontSize="10" FontWeight="SemiBold" Padding="5,1" Margin="2,0,4,0" Visibility="Collapsed" Cursor="Hand" ToolTip="Additional status and legend items are hidden due to narrow window. Click to scroll right." AutomationProperties.Name="Scroll Status Legend Items"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="2,2"/>
                    <Button x:Name="BtnShowLog" Content="Audit Console (Ctrl+L)" Style="{StaticResource ToolbarButtonStyle}" FontSize="11" Padding="6,1" AutomationProperties.Name="Toggle Audit Console"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- 4. Collapsible Audit & Telemetry Log Console Pane -->
        <Border x:Name="LogPane" DockPanel.Dock="Bottom" Background="{DynamicResource BrushLogBg}" Height="175" MinHeight="85" Visibility="Collapsed" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Thumb x:Name="LogPaneResizer" Grid.Row="0" Height="6" Cursor="SizeNS" ToolTip="Drag vertically to resize Audit &amp; Telemetry Console (max 2/3 window height; double-click to reset)">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="ResizeBarBd" Background="{DynamicResource BrushLogHeaderBg}" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="0,0,0,1">
                                <Border x:Name="ResizeGripPill" Width="36" Height="2" CornerRadius="1" Background="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ResizeBarBd" Property="Background" Value="{DynamicResource BrushLogBtnBg}"/>
                                    <Setter TargetName="ResizeGripPill" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="ResizeBarBd" Property="Background" Value="{DynamicResource BrushLogBtnBg}"/>
                                    <Setter TargetName="ResizeGripPill" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
                <Border Grid.Row="1" Background="{DynamicResource BrushLogHeaderBg}" Padding="8,4" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Console Title -->
                        <TextBlock Grid.Column="0" Text="Audit Trail &amp; Network Telemetry" Foreground="{DynamicResource BrushLogTitleFg}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Center: Fixed 4-Column Live Telemetry Grid Eliminating Horizontal Jitter Across Ticks -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.45*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="1.1*"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource BrushLogBg}" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0" ToolTip="Transport Mode, Round-Trip Latency &amp; Average Latency">
                                <TextBlock x:Name="TxtTelemTransport" Text="Mode: Initializing..." Foreground="{DynamicResource BrushLogTelem1}" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource BrushLogBg}" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0" ToolTip="Differential Compressed Wire Payload vs Uncompressed Raw JSON">
                                <TextBlock x:Name="TxtTelemPayload" Text="Wire: 0.00 KB (0% GZIP)" Foreground="{DynamicResource BrushLogTelem2}" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource BrushLogBg}" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0" ToolTip="Real-Time Network Bandwidth &amp; Cumulative Wire Transfer (RX)">
                                <TextBlock x:Name="TxtTelemNetwork" Text="BW: 0.00 KB/s | RX: 0.0 KB" Foreground="{DynamicResource BrushLogTelem3}" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Grid.Column="3" Background="{DynamicResource BrushLogBg}" BorderBrush="{DynamicResource BrushLogBorder}" BorderThickness="1" CornerRadius="2" Padding="4,1" ToolTip="Telemetry Sync Sequence &amp; Differential Process Delta (Dyn / +Meta / -Exit)">
                                <TextBlock x:Name="TxtTelemDelta" Text="Seq #0 | Dyn: 0 (+0/-0)" Foreground="{DynamicResource BrushLogTelem4}" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </Grid>

                        <!-- Right: Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkStreamTicks" Content="Stream Ticks" AutomationProperties.Name="Stream Ticks" IsChecked="True" Foreground="{DynamicResource BrushLogTitleFg}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand" ToolTip="Stream per-tick differential payload and network metrics"/>
                            <CheckBox x:Name="ChkLogAutoScroll" Content="Auto-Scroll" AutomationProperties.Name="Auto-Scroll Telemetry Console" IsChecked="True" Foreground="{DynamicResource BrushLogTitleFg}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand" ToolTip="Automatically scroll to newest log entries (unchecks when scrolled up; re-checks when scrolled to bottom)"/>
                            <Button x:Name="BtnCopyLog" Content="Copy" AutomationProperties.Name="Copy Console Log" Padding="7,1" FontSize="10" Margin="0,0,5,0" Background="{DynamicResource BrushLogBtnBg}" Foreground="{DynamicResource BrushLogBtnFg}" BorderThickness="0" Cursor="Hand" ToolTip="Copy Console Log to Clipboard"/>
                            <Button x:Name="BtnClearLog" Content="Clear" AutomationProperties.Name="Clear Console Log" Padding="7,1" FontSize="10" Margin="0,0,5,0" Background="{DynamicResource BrushLogBtnBg}" Foreground="{DynamicResource BrushLogBtnFg}" BorderThickness="0" Cursor="Hand"/>
                            <Button x:Name="BtnToggleLogPane" Content="Close [X]" AutomationProperties.Name="Close Audit Console" Padding="6,1" FontSize="10" Background="{DynamicResource BrushLogBtnBg}" Foreground="{DynamicResource BrushLogBtnFg}" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBox x:Name="TxtLogConsole" AutomationProperties.Name="Live Audit and Telemetry Log" Grid.Row="2" Background="{DynamicResource BrushLogBg}" Foreground="{DynamicResource BrushLogFg}" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="8,4" TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- 4B. Opt-In Network ETW Alert Banner (Circuit Breaker / Tier 1 Non-Admin Fallback) -->
        <Border x:Name="NetEtwAlertBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="10,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnNetEtwResume" Content="Resume Monitoring" AutomationProperties.Name="Resume Network ETW Monitoring" Padding="8,2" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Cursor="Hand"/>
                    <Button x:Name="BtnNetEtwTurnOff" Content="Turn Off" AutomationProperties.Name="Turn Off Network ETW Monitoring" Padding="8,2" FontSize="11" Margin="0,0,6,0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Cursor="Hand"/>
                    <Button x:Name="BtnNetEtwDismiss" Content="X" AutomationProperties.Name="Dismiss Network ETW Notice" Padding="5,2" FontSize="11" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource BrushTextMuted}" BorderThickness="0" Cursor="Hand" ToolTip="Dismiss Notice"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BdNetEtwBannerBadge" Background="{DynamicResource BrushBadgeBg}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtNetEtwBannerBadge" Text="CIRCUIT BREAKER" Foreground="{DynamicResource BrushRowSelectedFg}" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="TxtNetEtwBannerMsg" Text="" Foreground="{DynamicResource BrushTextPrimary}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 5. Main Workspace TabControl (Processes Tree-Grid & Services Manager) -->
        <TabControl x:Name="MainTabControl" AutomationProperties.Name="Main Workspace Tabs" BorderThickness="0" Background="{DynamicResource BrushSurfaceBg}" Padding="0">
            <TabItem Header="Processes">
                <Grid>
                    <DataGrid x:Name="GridProcesses" AutomationProperties.Name="Process Tree Table"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          VerticalGridLinesBrush="{DynamicResource BrushBorderSubtle}"
                          Background="{DynamicResource BrushSurfaceBg}"
                          RowHeaderWidth="0"
                          RowHeight="{DynamicResource GridRowHeight}"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLength="3,3"
                          VirtualizingPanel.CacheLengthUnit="Item"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="False">

                    <DataGrid.Resources>
                        <ContextMenu x:Key="ProcessHeaderContextMenu" Style="{StaticResource ContextMenuStyle}"/>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                            <Setter Property="ContextMenu" Value="{StaticResource ProcessHeaderContextMenu}"/>
                        </Style>
                    </DataGrid.Resources>

                    <!-- Contrast-Safe Row & Cell Styling -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding RowBackgroundBrush}"/>
                            <Setter Property="Foreground" Value="{Binding RowForegroundBrush}"/>
                            <Setter Property="Opacity" Value="{Binding RowOpacity}"/>
                            <Setter Property="FontWeight" Value="Normal"/>
                            <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Column 1: True Tree-Grid Process Column (Tree Guide Lines + Vector Expander + 16x16 Icon + Name + Command Line ToolTip) -->
                        <DataGridTemplateColumn x:Name="ColProcess" Header="Process" SortMemberPath="Name" Width="270">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel VerticalAlignment="Center" Height="{DynamicResource GridRowHeight}" Margin="2,0,0,0" Background="Transparent"
                                               ToolTipService.InitialShowDelay="150"
                                               ToolTipService.BetweenShowDelay="2000"
                                               ToolTipService.ShowDuration="60000">
                                        <DockPanel.ToolTip>
                                            <ToolTip Placement="Mouse" HorizontalOffset="20" VerticalOffset="8" MaxWidth="750" Padding="8,6">
                                                <TextBlock Text="{Binding ProcessHoverToolTip}"
                                                           FontFamily="Consolas, Segoe UI Mono, Lucida Console, Courier New"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextWrapping="Wrap"/>
                                            </ToolTip>
                                        </DockPanel.ToolTip>

                                        <!-- Process Explorer-Aligned Tree Indent, Guide Lines & Vector Expander Zone ((Level + 1) * 16 px) -->
                                        <Grid DockPanel.Dock="Left" Width="{Binding IndentWidth}" Height="{DynamicResource GridRowHeight}" Visibility="{Binding TreeGuideVis}" ClipToBounds="True">
                                            <!-- Continuous DPI-Safe Tree Connector Lines (vertical, T-junction, L-junction; empty when Show Tree Lines is Off) -->
                                            <Canvas Width="{Binding IndentWidth}" Height="{DynamicResource GridRowHeight}" IsHitTestVisible="False">
                                                <Path Data="{Binding TreeGuidePathGeometry}" Stroke="{DynamicResource BrushTreeLine}" StrokeThickness="1" RenderOptions.EdgeMode="Aliased"/>
                                            </Canvas>

                                            <!-- Interactive [+] / [-] Vector Box Expander (SlotWidth x RowHeight Hit Target, centered cleanly across all DPI scales) -->
                                            <Border x:Name="BtnToggleExpander" Width="{DynamicResource ExpanderSlotWidth}" Height="{DynamicResource GridRowHeight}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Visibility="{Binding ToggleVis}" Background="Transparent" Cursor="Hand"
                                                    ToolTipService.IsEnabled="False">
                                                <Grid Width="{DynamicResource ExpanderBoxSize}" Height="{DynamicResource ExpanderBoxSize}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.EdgeMode="Aliased">
                                                    <Rectangle Fill="{DynamicResource BrushSurfaceBg}" Stroke="{DynamicResource BrushTreeLine}" StrokeThickness="1"/>
                                                    <Path Data="{Binding ExpanderPathGeometry}" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1" IsHitTestVisible="False"/>
                                                </Grid>
                                            </Border>
                                        </Grid>

                                        <!-- Process Executable Icon (14x14 Standard / 11x11 Compact & Mini) -->
                                        <Grid DockPanel.Dock="Left" Width="{DynamicResource GridIconSize}" Height="{DynamicResource GridIconSize}" Margin="{DynamicResource GridIconMargin}" VerticalAlignment="Center">
                                            <Path Data="M3,2H13L17,6V18C17,19.1 16.1,20 15,20H3C1.9,20 1,19.1 1,18V4C1,2.9 1.9,2 3,2M12,3.5V7H15.5L12,3.5M5,9V11H13V9H5M5,13V15H10V13H5Z"
                                                  Fill="{DynamicResource BrushTextMuted}" Width="{DynamicResource GridFallbackIconSize}" Height="{DynamicResource GridFallbackIconSize}" Stretch="Uniform" Visibility="{Binding FallbackIconVis}"/>
                                            <Image Source="{Binding IconSource}" Width="{DynamicResource GridIconSize}" Height="{DynamicResource GridIconSize}" RenderOptions.BitmapScalingMode="LowQuality"/>
                                        </Grid>

                                        <!-- Process Name -->
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 2: CPU % (Right-Aligned Tabular + Subtle Green Column Tint) -->
                        <DataGridTemplateColumn x:Name="ColCpu" Header="CPU" SortMemberPath="CPU" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_CPU}" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding CpuCellToolTip}">
                                        <TextBlock Text="{Binding CPUFormatted}" Style="{StaticResource RightTabularText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 3: Tree CPU Usage % (Right-Aligned Tabular, Shown in Both Tree & Flat View) -->
                        <DataGridTextColumn x:Name="ColTreeCpu" Header="Tree CPU Usage" Binding="{Binding TreeCPUFormatted}" SortMemberPath="TreeCPU" Width="104" ElementStyle="{StaticResource RightTabularText}"/>

                        <!-- Opt-In Per-Process Kernel Network ETW Columns (Collapsed by Default, 0 Cost When Off) -->
                        <DataGridTemplateColumn x:Name="ColNetTotal" Header="Network" SortMemberPath="NetTotalBps" Width="94" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_Net}" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding NetToolTip}">
                                        <TextBlock Text="{Binding NetTotalFormatted}" Style="{StaticResource RightTabularText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn x:Name="ColTreeNet" Header="Tree Net" Binding="{Binding TreeNetTotalFormatted}" SortMemberPath="TreeNetTotalBps" Width="94" Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightTabularText}">
                                    <Setter Property="ToolTip" Value="{Binding NetToolTip}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColNetRx" Header="Net Recv" Binding="{Binding NetRxFormatted}" SortMemberPath="NetRxBps" Width="94" Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightTabularText}">
                                    <Setter Property="ToolTip" Value="{Binding NetToolTip}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColNetTx" Header="Net Send" Binding="{Binding NetTxFormatted}" SortMemberPath="NetTxBps" Width="94" Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightTabularText}">
                                    <Setter Property="ToolTip" Value="{Binding NetToolTip}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Column 4: Private Bytes (Right-Aligned Tabular + Subtle Cream Column Tint + Inline Baseline Badge) -->
                        <DataGridTemplateColumn x:Name="ColPrivateBytes" Header="Private Bytes" SortMemberPath="PrivateBytes" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_PrivateBytes}" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding PrivateCellToolTip}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PrivateBytesFormatted}" Style="{StaticResource RightTabularText}"/>
                                            <TextBlock Text="{Binding PrivateDeltaBadgeText}" Visibility="{Binding PrivateDeltaBadgeVis}" Style="{StaticResource PrivateDeltaBadgeStyle}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 5: Working Set (Right-Aligned Tabular + Subtle Peach Column Tint + Inline Baseline Badge) -->
                        <DataGridTemplateColumn x:Name="ColWorkingSet" Header="Working Set" SortMemberPath="MemoryBytes" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_WorkingSet}" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding WsCellToolTip}">
                                        <DockPanel LastChildFill="True">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding MemoryFormatted}" Style="{StaticResource RightTabularText}"/>
                                            <TextBlock Text="{Binding WsDeltaBadgeText}" Visibility="{Binding WsDeltaBadgeVis}" Style="{StaticResource WsDeltaBadgeStyle}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Opt-In Session Peak & Baseline Diff Columns (Collapsed by Default, Placed After Working Set) -->
                        <DataGridTextColumn x:Name="ColPeakCpu" Header="Peak CPU" Binding="{Binding PeakCPUFormatted}" SortMemberPath="PeakCPU" Width="76" Visibility="Collapsed" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn x:Name="ColPeakPrivate" Header="Peak Private" Binding="{Binding PeakPrivateBytesFormatted}" SortMemberPath="PeakPrivateBytes" Width="102" Visibility="Collapsed" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTemplateColumn x:Name="ColCpuDelta" Header="CPU Delta" SortMemberPath="CPUDelta" Width="78" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding CpuCellToolTip}">
                                        <TextBlock Text="{Binding CPUDeltaFormatted}" Style="{StaticResource CpuDeltaTabularStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColPrivateDelta" Header="Private Delta" SortMemberPath="PrivateBytesDelta" Width="102" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding PrivateCellToolTip}">
                                        <TextBlock Text="{Binding PrivateDeltaFormatted}" Style="{StaticResource PrivateDeltaTabularStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="ColWorkingSetDelta" Header="WS Delta" SortMemberPath="MemoryDelta" Width="98" Visibility="Collapsed">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Height="{DynamicResource GridRowHeight}" ToolTip="{Binding WsCellToolTip}">
                                        <TextBlock Text="{Binding MemoryDeltaFormatted}" Style="{StaticResource WsDeltaTabularStyle}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 6: PID (Right-Aligned Tabular) -->
                        <DataGridTextColumn x:Name="ColPid" Header="PID" Binding="{Binding PIDDisplay}" SortMemberPath="PID" Width="62" ElementStyle="{StaticResource RightTabularText}"/>

                        <!-- Column 7: Description (FileDescription / Hosted Services) -->
                        <DataGridTextColumn x:Name="ColDescription" Header="Description" Binding="{Binding Description}" SortMemberPath="Description" Width="240" MinWidth="100" ElementStyle="{StaticResource EllipsisCellText}"/>

                        <!-- Column 8: Company Name -->
                        <DataGridTextColumn x:Name="ColCompanyName" Header="Company Name" Binding="{Binding CompanyName}" SortMemberPath="CompanyName" Width="165" ElementStyle="{StaticResource EllipsisCellText}"/>

                        <!-- Column 9: User Account -->
                        <DataGridTextColumn x:Name="ColUser" Header="User" Binding="{Binding User}" SortMemberPath="User" Width="145" ElementStyle="{StaticResource EllipsisCellText}"/>

                        <!-- Column 10: Handles (Right-Aligned Tabular + Session Peak/Delta ToolTip) -->
                        <DataGridTextColumn x:Name="ColHandles" Header="Handles" Binding="{Binding HandlesFormatted}" SortMemberPath="Handles" Width="72">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource RightTabularText}">
