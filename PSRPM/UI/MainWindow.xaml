                                    <Path DockPanel.Dock="Left" Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"
                                          Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnClearSearchServices" DockPanel.Dock="Right" Content="X" AutomationProperties.Name="Clear Services Filter" Width="18" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" ToolTip="Clear Filter (Esc)"/>
                                    <TextBox x:Name="TxtSearchServices" AutomationProperties.Name="Filter Services" Width="180" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Filter services by Name, Display Name, PID, Status, or Account (Ctrl+F)"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Services DataGrid + Empty-State Overlay Container -->
                    <Grid>
                        <DataGrid x:Name="GridServices" AutomationProperties.Name="Windows Services Table"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}"
                              Background="{DynamicResource BrushSurfaceBg}"
                              Foreground="{DynamicResource BrushTextPrimary}"
                              RowHeaderWidth="0" RowHeight="{DynamicResource GridRowHeight}" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              EnableRowVirtualization="True">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="{DynamicResource GridHeaderFontSize}"/>
                                <Setter Property="Padding" Value="{DynamicResource GridHeaderPadding}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Setter Property="FontSize" Value="{DynamicResource GridFontSize}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Column 1: Service Name -->
                            <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" SortMemberPath="Name" Width="160" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 2: Display Name -->
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" SortMemberPath="DisplayName" Width="260" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 3: Host PID -->
                            <DataGridTextColumn Header="Host PID" Binding="{Binding PIDFormatted}" SortMemberPath="PID" Width="75" ElementStyle="{StaticResource RightTabularText}"/>

                            <!-- Column 4: Status -->
                            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontSize="{DynamicResource GridFontSize}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 5: Startup Type -->
                            <DataGridTextColumn Header="Startup Type" Binding="{Binding StartType}" SortMemberPath="StartType" Width="100" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 6: Log On As -->
                            <DataGridTextColumn Header="Log On As" Binding="{Binding User}" SortMemberPath="User" Width="140" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 7: Dependencies -->
                            <DataGridTextColumn Header="Dependencies" Binding="{Binding DependenciesFormatted}" SortMemberPath="Dependencies" Width="*" MinWidth="160" ElementStyle="{StaticResource EllipsisCellText}"/>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
