                                <Button x:Name="BtnSvcEmptyClear" Content="Clear Filter (Esc)" AutomationProperties.Name="Clear Services Filter" HorizontalAlignment="Center" Padding="12,4" FontSize="11" FontWeight="SemiBold" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <!-- Tab 3: Network Activity (TCPView Active Sockets & ETW Activity Stream) -->
            <TabItem x:Name="TabNetworkActivity" Header="Network Activity">
                <DockPanel Background="{DynamicResource BrushSurfaceBg}">
                    <!-- Top Sub-Mode, Quick Filter Chips & Action Toolbar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="{DynamicResource SubToolbarPadding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ToggleButton x:Name="BtnNetModeSockets" Content="Active Sockets" AutomationProperties.Name="View Active TCP and UDP Sockets" Style="{StaticResource ChipToggleStyle}" IsChecked="True" ToolTip="Live TCP/UDP endpoint table (Sysinternals TCPView style, auto-refreshes every 2s while visible)"/>
                                <ToggleButton x:Name="BtnNetModeTimeline" Content="ETW Activity Stream" AutomationProperties.Name="View ETW Network Activity Stream" Style="{StaticResource ChipToggleStyle}" Margin="0" ToolTip="Procmon-style per-process network burst stream (uses existing ETW telemetry)"/>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <Button x:Name="BtnNetRefreshSockets" Content="Refresh" AutomationProperties.Name="Refresh Active Network Sockets" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="Query live TCP/UDP endpoints across all processes on target host"/>
                                <ToggleButton x:Name="ChkNetAutoRefresh" Content="Auto (2s)" AutomationProperties.Name="Toggle 2-Second Auto Refresh" Style="{StaticResource ChipToggleStyle}" IsChecked="True" Margin="2,0,0,0" ToolTip="Refresh active endpoints every 2 seconds while Active Sockets is visible"/>
                                <Button x:Name="BtnNetCloseConn" Content="Close Conn" AutomationProperties.Name="Close Selected TCP Connection" Style="{StaticResource ToolbarButtonStyle}" IsEnabled="False" Margin="2,0,0,0" ToolTip="Close selected IPv4 TCP connection via SetTcpEntry (Administrator required)"/>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <!-- Sockets Filter Chips (TCPView Protocol & State Toggles) -->
                                <StackPanel x:Name="PanelNetSocketFilters" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ToggleButton x:Name="ChipNetTcp4" Content="TCP v4" AutomationProperties.Name="Filter TCP IPv4 Sockets" Style="{StaticResource ChipToggleStyle}" IsChecked="True"/>
                                    <ToggleButton x:Name="ChipNetTcp6" Content="TCP v6" AutomationProperties.Name="Filter TCP IPv6 Sockets" Style="{StaticResource ChipToggleStyle}" IsChecked="True"/>
                                    <ToggleButton x:Name="ChipNetUdp4" Content="UDP v4" AutomationProperties.Name="Filter UDP IPv4 Sockets" Style="{StaticResource ChipToggleStyle}" IsChecked="True"/>
                                    <ToggleButton x:Name="ChipNetUdp6" Content="UDP v6" AutomationProperties.Name="Filter UDP IPv6 Sockets" Style="{StaticResource ChipToggleStyle}" IsChecked="True"/>
                                    <ToggleButton x:Name="ChipNetEstablished" Content="Established" AutomationProperties.Name="Filter Established Sockets" Style="{StaticResource ChipToggleStyle}"/>
                                    <ToggleButton x:Name="ChipNetListening" Content="Listening" AutomationProperties.Name="Filter Listening Sockets" Style="{StaticResource ChipToggleStyle}"/>
                                    <ToggleButton x:Name="ChipNetSynSent" Content="Syn Sent" AutomationProperties.Name="Filter SYN Sent Sockets" Style="{StaticResource ChipToggleStyle}"/>
                                    <ToggleButton x:Name="ChipNetTimeWait" Content="Time/Close Wait" AutomationProperties.Name="Filter Time Wait and Close Wait Sockets" Style="{StaticResource ChipToggleStyle}" Margin="0"/>
                                </StackPanel>

                                <!-- Timeline Filter Chips -->
                                <StackPanel x:Name="PanelNetTimelineFilters" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                    <ToggleButton x:Name="ChipNetRecv" Content="Recv" AutomationProperties.Name="Filter Received Network Events" Style="{StaticResource ChipToggleStyle}"/>
                                    <ToggleButton x:Name="ChipNetSend" Content="Send" AutomationProperties.Name="Filter Sent Network Events" Style="{StaticResource ChipToggleStyle}" Margin="0"/>
                                </StackPanel>

                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>

                                <Button x:Name="BtnNetClear" Content="Clear" AutomationProperties.Name="Clear ETW Activity Stream" Style="{StaticResource ToolbarButtonStyle}" Visibility="Collapsed" ToolTip="Clear captured ETW timeline entries"/>
                                <Button x:Name="BtnNetExportCsv" Content="Export CSV" AutomationProperties.Name="Export Network Rows to CSV" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Export currently visible network rows to CSV"/>
                            </StackPanel>

                            <!-- Right-Docked Network Search Box -->
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center" Height="{DynamicResource SearchBoxHeight}">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"
                                          Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnClearSearchNetwork" DockPanel.Dock="Right" Content="X" AutomationProperties.Name="Clear Network Filter" Width="18" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" ToolTip="Clear Network Filter (Esc)"/>
                                    <TextBox x:Name="TxtSearchNetwork" AutomationProperties.Name="Filter Network Connections and Activity" Width="155" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Filter by Process, PID, Protocol, Address, Port, State, or Module Name (Ctrl+F)"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Teachable Inline Guidance Banner (ETW Disabled / Tier 1 Non-Admin Notice) -->
                    <Border x:Name="NetTabNoticeBanner" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="0,0,0,1" Padding="10,6">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnNetBannerEnableEtw" Content="Enable Net ETW" AutomationProperties.Name="Enable Kernel Network ETW Monitoring" Padding="8,2" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Cursor="Hand"/>
                                <Button x:Name="BtnNetBannerSwitchSockets" Content="View Active Sockets" AutomationProperties.Name="Switch to Active Sockets View" Padding="8,2" FontSize="11" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Cursor="Hand"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{DynamicResource BrushTargetNodeBg}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,8,0">
