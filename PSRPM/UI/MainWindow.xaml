                        <DataGridTextColumn x:Name="ColPath" Header="Image Path" Binding="{Binding Path}" SortMemberPath="Path" Width="240" Visibility="Collapsed">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EllipsisCellText}">
                                    <Setter Property="ToolTip" Value="{Binding Path}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColThreads" Header="Threads" Binding="{Binding Threads}" SortMemberPath="Threads" Width="68" Visibility="Collapsed" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn x:Name="ColParentPid" Header="Parent PID" Binding="{Binding ParentPID}" SortMemberPath="ParentPID" Width="78" Visibility="Collapsed" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn x:Name="ColSessionId" Header="Session" Binding="{Binding SessionId}" SortMemberPath="SessionId" Width="64" Visibility="Collapsed" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn x:Name="ColBasePriority" Header="Base Priority" Binding="{Binding BasePriority}" SortMemberPath="BasePriority" Width="88" Visibility="Collapsed" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn x:Name="ColArchitecture" Header="Architecture" Binding="{Binding Architecture}" SortMemberPath="Architecture" Width="78" Visibility="Collapsed" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn x:Name="ColStartTime" Header="Start Time" Binding="{Binding StartTime}" SortMemberPath="CreateTime" Width="135" Visibility="Collapsed" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn x:Name="ColStatus" Header="Status" Binding="{Binding Status}" SortMemberPath="Status" Width="82" Visibility="Collapsed" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn x:Name="ColServices" Header="Services" Binding="{Binding HostedServices}" SortMemberPath="HostedServices" Width="180" Visibility="Collapsed">
