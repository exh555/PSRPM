<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSRPM - PowerShell Remote Process Manager"
        Height="780" Width="1280" MinHeight="540" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Default Clean Light Theme (Sysinternals Process Explorer Refined) -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushToolbarBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BrushSurfaceBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushHeaderBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushTreeLine" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushRowHover" Color="#220284C7"/>
        <SolidColorBrush x:Key="BrushRowSelectedBg" Color="#006CBE"/>
        <SolidColorBrush x:Key="BrushRowSelectedFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBorder" Color="#94A3B8"/>

        <!-- Menu Theme Brushes (Clean Light Default vs Precision Dark) -->
        <SolidColorBrush x:Key="BrushMenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushMenuBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushMenuHover" Color="#F1F5F9"/>

        <!-- Subtle Column Metric Tints (Process Explorer Classic Column Tints) -->
        <SolidColorBrush x:Key="ColTint_CPU" Color="#2222C55E"/>
        <SolidColorBrush x:Key="ColTint_PrivateBytes" Color="#28EAB308"/>
        <SolidColorBrush x:Key="ColTint_WorkingSet" Color="#22F97316"/>

        <!-- Toolbar Button Style with Complete Interactive States -->
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-Aligned Tabular Numeric TextBlock Style -->
        <Style x:Key="RightTabularText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Single-Line Truncated Text Cell Style -->
        <Style x:Key="EllipsisCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Modern Global DataGridColumnHeader Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
        </Style>

        <!-- Modern Global TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="4,2,4,0">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <Border Grid.Row="1" Background="{TemplateBinding Background}">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Segmented Workspace TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="14,4"/>
            <Setter Property="Margin" Value="2,0,2,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0,0,0,2"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu &amp; ContextMenu Separator Style -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}" Margin="24,3,4,3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-Level Menu Header Template (File, Options, View, Process, Help) -->
        <ControlTemplate x:Key="TopLevelHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="7,3" Margin="1,0">
                <Grid>
                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Bottom" PopupAnimation="Fade" VerticalOffset="1">
                        <Border Background="{DynamicResource BrushMenuBg}"
                                BorderBrush="{DynamicResource BrushMenuBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="2">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                </MultiTrigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Top-Level Menu Item Template (Standalone Action on Menu Bar) -->
        <ControlTemplate x:Key="TopLevelItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="7,3" Margin="1,0">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dropdown &amp; Context Submenu Item Template -->
        <ControlTemplate x:Key="SubmenuItemTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="2,4" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" SharedSizeGroup="MenuItemIconColumnGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Checkmark" Grid.Column="0"
                          Data="M 2.5,6.5 L 5.5,9.5 L 11.5,3.5"
                          Stroke="{DynamicResource BrushTextPrimary}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                    <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontWeight="Normal" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,4,0"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                    <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="Checkmark" Property="Stroke" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="GestureText" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Nested Dropdown Submenu Header Template (Update Speed, Set Priority) -->
        <ControlTemplate x:Key="SubmenuHeaderTemplate" TargetType="MenuItem">
            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="2,4" Margin="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" SharedSizeGroup="MenuItemIconColumnGroup"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="MenuItemGestureColumnGroup"/>
                        <ColumnDefinition Width="16"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Checkmark" Grid.Column="0"
                          Data="M 2.5,6.5 L 5.5,9.5 L 11.5,3.5"
                          Stroke="{DynamicResource BrushTextPrimary}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          Width="14" Height="14"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                    <ContentPresenter x:Name="IconHost" Grid.Column="0" ContentSource="Icon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,16,0"/>
                    <TextBlock x:Name="GestureText" Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontWeight="Normal" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,4,0"/>
                    <Path x:Name="Arrow" Grid.Column="3" Data="M 0,0 L 4,3.5 L 0,7 Z" Fill="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                           IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                           Placement="Right" HorizontalOffset="-2" VerticalOffset="-2" PopupAnimation="Fade">
                        <Border Background="{DynamicResource BrushMenuBg}"
                                BorderBrush="{DynamicResource BrushMenuBorder}"
                                BorderThickness="1" CornerRadius="3" Padding="2">
                            <ItemsPresenter Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"
                                            KeyboardNavigation.TabNavigation="Cycle"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Checkmark" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsHighlighted" Value="True"/>
                        <Condition Property="IsEnabled" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BrushTextPrimary}"/>
                    <Setter TargetName="GestureText" Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
                </MultiTrigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushMenuHover}"/>
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BrushTextPrimary}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource BrushTextMuted}"/>
                    <Setter TargetName="GestureText" Property="Opacity" Value="0.4"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Unified MenuItem Style routing by Role -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="Role" Value="TopLevelHeader">
                    <Setter Property="Template" Value="{StaticResource TopLevelHeaderTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="TopLevelItem">
                    <Setter Property="Template" Value="{StaticResource TopLevelItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuItem">
                    <Setter Property="Template" Value="{StaticResource SubmenuItemTemplate}"/>
                </Trigger>
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource SubmenuHeaderTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Clean ContextMenu Flyout Style -->
        <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource BrushMenuBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushMenuBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Grid.IsSharedSizeScope" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter SnapsToDevicePixels="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource ContextMenuStyle}"/>

        <!-- Clean Modern Theme-Aware ToolTip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 1. Classic Sysinternals Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderBg}" Foreground="{DynamicResource BrushTextPrimary}" Padding="2,1" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem x:Name="MenuConnectHost" Header="_Connect / Switch Host..." InputGestureText="Ctrl+K" FontWeight="SemiBold"/>
                <MenuItem x:Name="MenuNewHostTab" Header="New _Host Session Tab..." InputGestureText="Ctrl+Shift+K"/>
                <MenuItem x:Name="MenuCloseHostTab" Header="Close Current Host _Tab" InputGestureText="Ctrl+W"/>
                <MenuItem x:Name="MenuSwitchLocal" Header="Switch to _Local Mode (-LocalOnly)"/>
                <Separator/>
                <MenuItem x:Name="MenuRefresh" Header="_Refresh Now" InputGestureText="F5"/>
                <MenuItem x:Name="MenuExportCsv" Header="_Export Process Snapshot (CSV)..." InputGestureText="Ctrl+S"/>
                <MenuItem x:Name="MenuExportJson" Header="Export Forensic Snapshot (_JSON)..."/>
                <Separator/>
                <MenuItem x:Name="MenuFileHelp" Header="_Help &amp; Shortcuts..." InputGestureText="F1"/>
                <Separator/>
                <MenuItem x:Name="MenuExit" Header="E_xit" InputGestureText="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Options">
                <MenuItem Header="_Theme">
                    <MenuItem x:Name="MenuThemeLight" Header="_Clean Light Theme (Sysinternals)" IsCheckable="True" IsChecked="True"/>
                    <MenuItem x:Name="MenuThemeDark" Header="_Precision Dark Theme" InputGestureText="Ctrl+D" IsCheckable="True"/>
                    <MenuItem x:Name="MenuThemeClassic" Header="_Sysinternals Classic (Win32 Retro)" IsCheckable="True"/>
                    <MenuItem x:Name="MenuThemeHighContrast" Header="_High-Contrast Monochrome (WCAG AAA)" IsCheckable="True"/>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="MenuHighlightCategories" Header="_Highlight Process Categories" IsCheckable="True" IsChecked="True" ToolTip="Toggle static category row colors (Services, User, Packaged, Suspended) while preserving dynamic New (Green) and Exiting (Red) flashes"/>
                <Separator/>
                <MenuItem x:Name="MenuConfirmKill" Header="Confirm _Kill Process Actions" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="MenuVerboseTelemetry" Header="Log Verbose _Telemetry Ticks" IsCheckable="True" IsChecked="True"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="MenuSystemInfo" Header="_System Information..." InputGestureText="Ctrl+I" FontWeight="SemiBold"/>
                <Separator/>
                <MenuItem x:Name="MenuNextHostTab" Header="Next Host _Tab" InputGestureText="Ctrl+Tab"/>
                <MenuItem x:Name="MenuPrevHostTab" Header="Previous Host Tab" InputGestureText="Ctrl+Shift+Tab"/>
                <Separator/>
                <MenuItem x:Name="MenuViewTree" Header="Show Process _Tree" InputGestureText="Ctrl+T" IsCheckable="True" IsChecked="True"/>
                <MenuItem x:Name="MenuViewFlat" Header="Show _Flat List" IsCheckable="True"/>
                <Separator/>
                <MenuItem x:Name="MenuExpandAll" Header="_Expand All Tree Nodes"/>
                <MenuItem x:Name="MenuCollapseAll" Header="_Collapse All Tree Nodes"/>
                <Separator/>
                <MenuItem x:Name="MenuViewLog" Header="_Activity &amp; Audit Log Pane" InputGestureText="Ctrl+L" IsCheckable="True"/>
                <MenuItem Header="_Update Speed">
                    <MenuItem x:Name="MenuRate500ms" Header="High (500 ms)" IsCheckable="True"/>
                    <MenuItem x:Name="MenuRate1s" Header="Normal (1 second)" IsCheckable="True" IsChecked="True"/>
                    <MenuItem x:Name="MenuRate2s" Header="Standard (2 seconds)" IsCheckable="True"/>
                    <MenuItem x:Name="MenuRate5s" Header="Low (5 seconds)" IsCheckable="True"/>
                    <Separator/>
                    <MenuItem x:Name="MenuRatePaused" Header="_Paused" InputGestureText="Space" IsCheckable="True"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Process">
                <MenuItem x:Name="MenuProperties" Header="_Properties..." InputGestureText="Enter" FontWeight="SemiBold"/>
                <Separator/>
                <MenuItem x:Name="MenuSuspend" Header="_Suspend Process"/>
                <MenuItem x:Name="MenuResume" Header="R_esume Process"/>
                <Separator/>
                <MenuItem x:Name="MenuEndProcess" Header="_Kill Process" InputGestureText="Del"/>
                <MenuItem x:Name="MenuEndProcessTree" Header="Kill Process _Tree" InputGestureText="Shift+Del"/>
                <Separator/>
                <MenuItem Header="Set _Priority">
                    <MenuItem x:Name="MenuPrioIdle" Header="Idle (Low)"/>
                    <MenuItem x:Name="MenuPrioBelow" Header="Below Normal"/>
                    <MenuItem x:Name="MenuPrioNormal" Header="Normal"/>
                    <MenuItem x:Name="MenuPrioAbove" Header="Above Normal"/>
                    <MenuItem x:Name="MenuPrioHigh" Header="High"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Create _Dump">
                    <MenuItem x:Name="MenuCreateMiniDump" Header="Create _Minidump..." ToolTip="Create lightweight minidump on remote target in C:\temp"/>
                    <MenuItem x:Name="MenuCreateFullDump" Header="Create _Full Memory Dump..." ToolTip="Create complete memory dump on remote target in C:\temp"/>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Find">
                <MenuItem x:Name="MenuFindHandle" Header="_Find Handle or DLL..." InputGestureText="Ctrl+Shift+F" FontWeight="SemiBold"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem x:Name="MenuHelpTopics" Header="_Keyboard Shortcuts &amp; Reference..." InputGestureText="F1" FontWeight="SemiBold"/>
                <MenuItem x:Name="MenuHelpArchitecture" Header="_Architecture &amp; Safety Overview..."/>
                <MenuItem x:Name="MenuHelpConnectivity" Header="_Remoting &amp; Connectivity Guide..."/>
                <Separator/>
                <MenuItem x:Name="MenuHelpAbout" Header="_About PSRPM..."/>
            </MenuItem>
        </Menu>

        <!-- 1B. Multi-Host Tabbed Session Strip -->
        <Border x:Name="HostTabBar" DockPanel.Dock="Top" Background="{DynamicResource BrushHeaderBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,4,6,0">
            <DockPanel>
                <Button x:Name="BtnAddHostTab" DockPanel.Dock="Right" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" Margin="4,0,2,2" ToolTip="Connect to Another Remote Host or Local (Ctrl+Shift+K)" Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="+" FontSize="13" FontWeight="Bold" Foreground="#0284C7" Margin="0,-2,3,0"/>
                        <TextBlock Text="Add Host" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="HostTabsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabItemBorder" Background="{Binding TabBackground}" BorderBrush="{Binding TabBorderBrush}" BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" Padding="8,3,6,3" Margin="0,0,4,0" Cursor="Hand" ToolTip="{Binding ComputerName}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding StatusDotFill}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding TitleForeground}" FontWeight="{Binding TitleFontWeight}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Border Grid.Column="2" Background="{Binding BadgeBackground}" CornerRadius="2" Padding="3,0" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Transport}" Foreground="White" FontSize="8.5" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Grid.Column="3" Text="{Binding LatencyText}" Foreground="{DynamicResource BrushTextMuted}" FontSize="9.5" Margin="0,0,5,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                                        <Button Grid.Column="4" x:Name="BtnCloseHostTab" Content="x" Width="14" Height="14" FontSize="10" FontWeight="Bold" Padding="0,-3,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextMuted}" Visibility="{Binding CloseVisibility}" ToolTip="Close Session Tab (Ctrl+W)" Cursor="Hand"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 2. Unified Command, Connection Badge & Real-Time Sparkline Telemetry Strip -->
        <Border x:Name="SummaryBar" DockPanel.Dock="Top" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Col 0: Legacy Target Connection Badge (Collapsed: HostTabBar provides host session management) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="ConnStatusDot" Width="8" Height="8" Fill="#16A34A" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTargetBadge" Text="LOCALHOST" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <Border Background="#0284C7" CornerRadius="2" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtTransportBadge" Text="WINRM" Foreground="White" FontSize="9" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="TxtLatencyBadge" Text="0 ms" Foreground="{DynamicResource BrushTextMuted}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="BtnConnectHost" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Connect / Switch Remote Target (Ctrl+K)" Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z" Fill="#0284C7" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="Connect" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Col 1: Sysinternals Quick Action Vector Toolbar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button x:Name="BtnToolbarRefresh" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Refresh Now (F5)">
                        <Path Data="M12,4V1L8,5l4,4V6c3.31,0,6,2.69,6,6c0,1.01-0.25,1.97-0.7,2.8l1.46,1.46C19.54,15.03,20,13.57,20,12C20,7.58,16.42,4,12,4z M12,18c-3.31,0-6-2.69-6-6c0-1.01,0.25-1.97,0.7-2.8L5.24,7.74C4.46,8.97,4,10.43,4,12c0,4.42,3.58,8,8,8v3l4-4l-4-4V18z" Fill="#0284C7" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnToolbarPause" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Pause Polling (Space)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="IconToolbarPause" Data="M6,19h4V5H6V19z M14,5v14h4V5H14z" Fill="{DynamicResource BrushTextSecondary}" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock x:Name="TxtToolbarPause" Text="" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                    <Button x:Name="BtnToolbarTree" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Toggle Process Tree / Flat View (Ctrl+T)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M3,3h6v4H3V3z M7,7v5h4v-2h6v4h-6v-2H7v6h4v-2h6v4h-6v-2H5V7H3z" Fill="#16A34A" Width="15" Height="15" Stretch="Uniform"/>
                            <TextBlock x:Name="TxtModeIndicator" Text="Tree" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnToolbarProps" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Inspect Process Properties (Enter)">
                        <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-6h2V17z M13,9h-2V7h2V9z" Fill="#0284C7" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnToolbarKill" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Kill Selected Process (Del)">
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41z" Fill="#DC2626" Width="15" Height="15" Stretch="Uniform"/>
                    </Button>
                    <Button x:Name="BtnToolbarKillTree" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Kill Process Tree (Shift+Del)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41z" Fill="#991B1B" Width="14" Height="14" Stretch="Uniform"/>
                            <TextBlock Text="Tree" FontSize="10" FontWeight="Bold" Foreground="#991B1B" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                    <Button x:Name="BtnFindHandleOrDll" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Find Handle or DLL Substring (Ctrl+Shift+F)">
                        <Path Data="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14Z" Fill="#0284C7" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="3,2"/>
                    <Button x:Name="BtnToolbarTheme" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Switch Light / Dark Theme (Ctrl+D)">
                        <TextBlock x:Name="TxtThemeToggle" Text="Dark Mode" FontSize="11" FontWeight="SemiBold"/>
                    </Button>
                    <Button x:Name="BtnToolbarHelp" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Help, Keyboard Shortcuts &amp; About (F1)" Margin="2,0,0,0">
                        <Path Data="M11,18h2v-2h-2V18z M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z M12,6c-2.21,0-4,1.79-4,4h2c0-1.1,0.9-2,2-2s2,0.9,2,2c0,2-3,1.75-3,5h2c0-2.25,3-2.5,3-5C16,7.79,14.21,6,12,6z" Fill="#0284C7" Width="14" Height="14" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <!-- Col 2: Sysinternals Mini Telemetry Sparkline Strip (Double-Click for System Information) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- CPU Sparkline Box -->
                    <Border x:Name="CardMiniCpu" CornerRadius="4" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" Background="{DynamicResource BrushSparkBg}" Margin="0,0,5,0" Cursor="Hand" ToolTip="Double-click to open System Information - CPU (Ctrl+I)">
                        <Grid Width="86" Height="26" ClipToBounds="True">
                            <Polygon Points="{Binding CpuFillPoints}" Fill="#3322C55E"/>
                            <Polyline Points="{Binding CpuPoints}" Stroke="#16A34A" StrokeThickness="1.3"/>
                            <TextBlock Text="CPU" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtCpuSummary" Text="{Binding CpuSummaryFormatted}" FontSize="10" FontWeight="Bold" Margin="0,1,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </Border>

                    <!-- Commit Charge Sparkline Box -->
                    <Border x:Name="CardMiniCommit" CornerRadius="4" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" Background="{DynamicResource BrushSparkBg}" Margin="0,0,5,0" Cursor="Hand" ToolTip="Double-click to open System Information - Commit &amp; Memory (Ctrl+I)">
                        <Grid Width="90" Height="26" ClipToBounds="True">
                            <Polygon Points="{Binding CommitFillPoints}" Fill="#33EAB308"/>
                            <Polyline Points="{Binding CommitPoints}" Stroke="#CA8A04" StrokeThickness="1.3"/>
                            <TextBlock Text="Commit" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtCommitSummary" Text="{Binding CommitSummaryFormatted}" FontSize="10" FontWeight="Bold" Margin="0,1,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </Border>

                    <!-- Physical RAM Sparkline Box -->
                    <Border x:Name="CardMiniRam" CornerRadius="4" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" Background="{DynamicResource BrushSparkBg}" Margin="0,0,8,0" Cursor="Hand" ToolTip="Double-click to open System Information - Physical Memory (Ctrl+I)">
                        <Grid Width="96" Height="26" ClipToBounds="True">
                            <Polygon Points="{Binding RamFillPoints}" Fill="#33F97316"/>
                            <Polyline Points="{Binding RamPoints}" Stroke="#EA580C" StrokeThickness="1.3"/>
                            <TextBlock Text="Phys RAM" FontSize="9" Foreground="{DynamicResource BrushTextMuted}" Margin="3,1,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="TxtRamSummary" Text="{Binding RamPctFormatted}" FontSize="10" FontWeight="Bold" Margin="0,1,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </Border>

                    <!-- Compact System Totals (2-Line Stack Prevents Horizontal Clipping) -->
                    <StackPanel VerticalAlignment="Center" Margin="2,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Procs: " Foreground="{DynamicResource BrushTextMuted}" FontSize="10"/>
                            <TextBlock x:Name="TxtProcCount" Text="{Binding ProcessCount}" FontWeight="Bold" FontSize="10" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="Handles: " Foreground="{DynamicResource BrushTextMuted}" FontSize="10"/>
                            <TextBlock x:Name="TxtHandleCount" Text="{Binding HandleCount}" FontWeight="Bold" FontSize="10" Typography.NumeralAlignment="Tabular"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Live Hardware Throughput (Network & Storage) Tabular Pill -->
                    <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="3,0,0,0" VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTelemNetRate" Text="{Binding NetThroughputFormatted}" Foreground="#0284C7" FontSize="9.5" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" ToolTip="Real-Time Network Interface Throughput (Rx / Tx)"/>
                            <TextBlock x:Name="TxtTelemDiskRate" Text="{Binding DiskActivityFormatted}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="9.5" Typography.NumeralAlignment="Tabular" Margin="0,1,0,0" ToolTip="Real-Time Storage &amp; System I/O Activity (Throughput &amp; IOPS)"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Col 3: Right-Docked Instant Search / Filter Box -->
                <Border Grid.Column="3" Width="260" MinWidth="220" MaxWidth="360" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center" Height="26">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"
                              Fill="{DynamicResource BrushTextMuted}" Width="12" Height="12" Stretch="Uniform" Margin="6,0,2,0" VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearSearch" DockPanel.Dock="Right" Content="X" Width="20" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" ToolTip="Clear Filter (Esc)"/>
                        <TextBlock x:Name="TxtMatchCount" DockPanel.Dock="Right" Text="" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center" Margin="2,0,4,0" Typography.NumeralAlignment="Tabular"/>
                        <TextBox x:Name="TxtSearch" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Filter by Process Name, PID, Description, Company, User, or Service (Ctrl+F)"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Bottom Status Bar & Interactive Semantic Color Legend -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource BrushHeaderBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="6,2">
            <!-- Fixed-width left telemetry section eliminates horizontal jitter across ticks -->
            <StatusBarItem Width="610">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgePaused" Background="#F59E0B" CornerRadius="2" Padding="5,1" Margin="0,0,6,0" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="PAUSED" Foreground="#0F172A" FontSize="9.5" FontWeight="Bold"/>
                    </Border>
                    <TextBlock x:Name="StatusText" Text="Initializing Telemetry Engine..." FontSize="11" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFilterLegendLabel" Text="Filter Legend:" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Button x:Name="BtnLegendAll" Content="All" FontSize="10" FontWeight="Bold" Padding="6,1" Margin="0,0,4,0" Background="#E2E8F0" Foreground="#0F172A" BorderBrush="#0284C7" BorderThickness="2" Cursor="Hand" ToolTip="Show All Process Categories"/>
                    <Button x:Name="BtnLegendService" Content="Services" FontSize="10" Padding="6,1" Margin="0,0,4,0" Background="#FFE4E6" Foreground="#0F172A" BorderBrush="#FDA4AF" BorderThickness="1" Cursor="Hand" ToolTip="Filter Service Processes (Click to toggle)"/>
                    <Button x:Name="BtnLegendOwn" Content="Own / User" FontSize="10" Padding="6,1" Margin="0,0,4,0" Background="#E0E7FF" Foreground="#0F172A" BorderBrush="#A5B4FC" BorderThickness="1" Cursor="Hand" ToolTip="Filter User Session Processes (Click to toggle)"/>
                    <Button x:Name="BtnLegendPackaged" Content="Packaged / WebView" FontSize="10" Padding="6,1" Margin="0,0,4,0" Background="#67E8F9" Foreground="#0F172A" BorderBrush="#06B6D4" BorderThickness="1" Cursor="Hand" ToolTip="Filter Packaged / WebView2 Processes (Click to toggle)"/>
                    <Button x:Name="BtnLegendClear" Content="Clear Filter" FontSize="9" FontWeight="Bold" Padding="5,1" Margin="2,0,6,0" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#F87171" BorderThickness="1" Cursor="Hand" Visibility="Collapsed" ToolTip="Clear active category filter and show all processes"/>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2"/>
                    <TextBlock Text="Lifecycle Badges:" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <Border Background="#94A3B8" BorderBrush="#64748B" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="Suspended" Foreground="#0F172A" FontSize="10"/>
                    </Border>
                    <Border Background="#86EFAC" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="2" Padding="5,1" Margin="0,0,4,0">
                        <TextBlock Text="New" Foreground="#0F172A" FontSize="10"/>
                    </Border>
                    <Border Background="#FCA5A5" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="2" Padding="5,1">
                        <TextBlock Text="Exiting" Foreground="#0F172A" FontSize="10"/>
                    </Border>
                    <Button x:Name="BtnToggleHighlights" Content="Colors: Standard" FontSize="9.5" FontWeight="SemiBold" Padding="5,1" Margin="6,0,0,0" Background="{DynamicResource BrushToolbarBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" Cursor="Hand" ToolTip="Toggle static category coloring on/off (New &amp; Exiting flashes remain active)"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <Button x:Name="BtnShowLog" Content="Audit Console (Ctrl+L)" Style="{StaticResource ToolbarButtonStyle}" FontSize="11" Padding="6,1"/>
            </StatusBarItem>
        </StatusBar>

        <!-- 4. Collapsible Audit & Telemetry Log Console Pane -->
        <Border x:Name="LogPane" DockPanel.Dock="Bottom" Background="#0F172A" Height="175" Visibility="Collapsed" BorderBrush="#334155" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#1E293B" Padding="8,4" BorderBrush="#334155" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Console Title -->
                        <TextBlock Grid.Column="0" Text="Audit Trail &amp; Network Telemetry" Foreground="#F8FAFC" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <!-- Center: Fixed 4-Column Live Telemetry Grid Eliminating Horizontal Jitter Across Ticks -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0" ToolTip="Transport Mode, Round-Trip Latency &amp; Average Latency">
                                <TextBlock x:Name="TxtTelemTransport" Text="Mode: Initializing..." Foreground="#38BDF8" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Grid.Column="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0" ToolTip="Differential Compressed Wire Payload vs Uncompressed Raw JSON">
                                <TextBlock x:Name="TxtTelemPayload" Text="Wire: 0.00 KB (0% GZIP)" Foreground="#A7F3D0" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="4,1" Margin="0,0,4,0" ToolTip="Real-Time Network Bandwidth &amp; Cumulative Wire Transfer (RX)">
                                <TextBlock x:Name="TxtTelemNetwork" Text="BW: 0.00 KB/s | RX: 0.0 KB" Foreground="#FDE68A" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                            <Border Grid.Column="3" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="2" Padding="4,1" ToolTip="Telemetry Sync Sequence &amp; Differential Process Delta (Dyn / +Meta / -Exit)">
                                <TextBlock x:Name="TxtTelemDelta" Text="Seq #0 | Dyn: 0 (+0/-0)" Foreground="#DDD6FE" FontFamily="Consolas" FontSize="9.5" TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular"/>
                            </Border>
                        </Grid>

                        <!-- Right: Action Controls -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkStreamTicks" Content="Stream Ticks" IsChecked="True" Foreground="#CBD5E1" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0" Cursor="Hand" ToolTip="Stream per-tick differential payload and network metrics"/>
                            <Button x:Name="BtnCopyLog" Content="Copy" Padding="7,1" FontSize="10" Margin="0,0,5,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand" ToolTip="Copy Console Log to Clipboard"/>
                            <Button x:Name="BtnClearLog" Content="Clear" Padding="7,1" FontSize="10" Margin="0,0,5,0" Background="#334155" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button x:Name="BtnToggleLogPane" Content="Close [X]" Padding="6,1" FontSize="10" Background="#475569" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <TextBox x:Name="TxtLogConsole" Grid.Row="1" Background="#0F172A" Foreground="#38BDF8" FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="8,4" TextWrapping="NoWrap"/>
            </Grid>
        </Border>

        <!-- 5. Main Workspace TabControl (Processes Tree-Grid & Services Manager) -->
        <TabControl x:Name="MainTabControl" BorderThickness="0" Background="{DynamicResource BrushSurfaceBg}" Padding="0">
            <TabItem Header="Processes">
                <DataGrid x:Name="GridProcesses"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Vertical"
                          VerticalGridLinesBrush="{DynamicResource BrushBorderSubtle}"
                          Background="{DynamicResource BrushSurfaceBg}"
                          RowHeaderWidth="0"
                          RowHeight="22"
                          BorderThickness="0"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingPanel.CacheLength="20,20"
                          VirtualizingPanel.CacheLengthUnit="Item"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="False">

                    <!-- Contrast-Safe Row & Cell Styling -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{Binding RowBackground}"/>
                            <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                            <Setter Property="Opacity" Value="{Binding RowOpacity}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Foreground" Value="{Binding RowForeground}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Column 1: True Tree-Grid Process Column (Tree Guide Lines + Vector Expander + 16x16 Icon + Name + Command Line ToolTip) -->
                        <DataGridTemplateColumn Header="Process" SortMemberPath="Name" Width="270">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel VerticalAlignment="Center" Height="22" Background="Transparent"
                                               ToolTipService.InitialShowDelay="150"
                                               ToolTipService.BetweenShowDelay="2000"
                                               ToolTipService.ShowDuration="60000">
                                        <DockPanel.ToolTip>
                                            <ToolTip Placement="Mouse" HorizontalOffset="20" VerticalOffset="8" MaxWidth="750" Padding="8,6">
                                                <TextBlock Text="{Binding CommandLineToolTip}"
                                                           FontFamily="Consolas, Segoe UI Mono, Lucida Console, Courier New"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextWrapping="Wrap"/>
                                            </ToolTip>
                                        </DockPanel.ToolTip>

                                        <!-- Continuous Pixel-Snapped Tree Connector Lines (vertical, T-junction, L-junction) -->
                                        <Canvas DockPanel.Dock="Left" Width="{Binding IndentWidth}" Height="22" Visibility="{Binding TreeGuideVisibility}" ClipToBounds="True">
                                            <Path Data="{Binding TreeGuideGeometry}" Stroke="{DynamicResource BrushTreeLine}" StrokeThickness="1" SnapsToDevicePixels="True"/>
                                        </Canvas>

                                        <!-- Interactive [+] / [-] Vector Box Expander (16x20 Hit Target) -->
                                        <Border DockPanel.Dock="Left" x:Name="BtnToggleExpander" Width="16" Height="20" Margin="0,0,2,0" VerticalAlignment="Center"
                                                Visibility="{Binding ToggleVisibility}" Background="Transparent" Cursor="Hand"
                                                ToolTipService.IsEnabled="False">
                                            <Border Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushTreeLine}" BorderThickness="1">
                                                <Path Data="{Binding ExpanderGeometry}" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.1" SnapsToDevicePixels="True" IsHitTestVisible="False"/>
                                            </Border>
                                        </Border>

                                        <!-- Leaf Spacer when node has no children -->
                                        <Border DockPanel.Dock="Left" Width="4" Height="1" Visibility="{Binding LeafVisibility}"/>

                                        <!-- 16x16 Process Executable Icon (with crisp vector fallback) -->
                                        <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="1,0,5,0" VerticalAlignment="Center">
                                            <Path Data="M3,2H13L17,6V18C17,19.1 16.1,20 15,20H3C1.9,20 1,19.1 1,18V4C1,2.9 1.9,2 3,2M12,3.5V7H15.5L12,3.5M5,9V11H13V9H5M5,13V15H10V13H5Z"
                                                  Fill="#64748B" Width="13" Height="13" Stretch="Uniform" Visibility="{Binding FallbackIconVisibility}"/>
                                            <Image Source="{Binding IconSource}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>

                                        <!-- Process Name -->
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding NameFontWeight}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 2: CPU % (Right-Aligned Tabular + Subtle Green Column Tint) -->
                        <DataGridTemplateColumn Header="CPU" SortMemberPath="CPU" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_CPU}" Height="22">
                                        <TextBlock Text="{Binding CPUFormatted}" Style="{StaticResource RightTabularText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 3: Private Bytes (Right-Aligned Tabular + Subtle Cream Column Tint) -->
                        <DataGridTemplateColumn Header="Private Bytes" SortMemberPath="PrivateBytes" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_PrivateBytes}" Height="22">
                                        <TextBlock Text="{Binding PrivateBytesFormatted}" Style="{StaticResource RightTabularText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 4: Working Set (Right-Aligned Tabular + Subtle Peach Column Tint) -->
                        <DataGridTemplateColumn Header="Working Set" SortMemberPath="MemoryBytes" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ColTint_WorkingSet}" Height="22">
                                        <TextBlock Text="{Binding MemoryFormatted}" Style="{StaticResource RightTabularText}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Column 5: PID (Right-Aligned Tabular) -->
                        <DataGridTextColumn Header="PID" Binding="{Binding PIDDisplay}" SortMemberPath="PID" Width="62" ElementStyle="{StaticResource RightTabularText}"/>

                        <!-- Column 6: Description (FileDescription / Hosted Services) -->
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" SortMemberPath="Description" Width="*" MinWidth="220" ElementStyle="{StaticResource EllipsisCellText}"/>

                        <!-- Column 7: Company Name -->
                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" SortMemberPath="CompanyName" Width="165" ElementStyle="{StaticResource EllipsisCellText}"/>

                        <!-- Column 8: User Account -->
                        <DataGridTextColumn Header="User" Binding="{Binding User}" SortMemberPath="User" Width="145" ElementStyle="{StaticResource EllipsisCellText}"/>

                        <!-- Column 9: Handles (Right-Aligned Tabular) -->
                        <DataGridTextColumn Header="Handles" Binding="{Binding HandlesFormatted}" SortMemberPath="Handles" Width="72" ElementStyle="{StaticResource RightTabularText}"/>
                    </DataGrid.Columns>

                    <DataGrid.ContextMenu>
                        <ContextMenu Style="{StaticResource ContextMenuStyle}">
                            <MenuItem x:Name="CtxProperties" Header="Properties..." InputGestureText="Enter" FontWeight="Bold"/>
                            <Separator/>
                            <MenuItem x:Name="CtxSuspend" Header="Suspend Process"/>
                            <MenuItem x:Name="CtxResume" Header="Resume Process"/>
                            <Separator/>
                            <MenuItem x:Name="CtxEndProcess" Header="Kill Process" InputGestureText="Del"/>
                            <MenuItem x:Name="CtxEndTree" Header="Kill Process Tree" InputGestureText="Shift+Del"/>
                            <Separator/>
                            <MenuItem Header="Create Dump">
                                <MenuItem x:Name="CtxCreateMiniDump" Header="Create Minidump..."/>
                                <MenuItem x:Name="CtxCreateFullDump" Header="Create Full Memory Dump..."/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="CtxCopyCmdLine" Header="Copy Command Line"/>
                            <MenuItem x:Name="CtxCopyPath" Header="Copy Executable Path"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </TabItem>

            <!-- Tab 2: Windows Services -->
            <TabItem Header="Services">
                <DockPanel Background="{DynamicResource BrushSurfaceBg}">
                    <!-- Services Action &amp; Filter Toolbar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnSvcStart" Content="Start Service" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="Start selected service"/>
                                <Button x:Name="BtnSvcStop" Content="Stop Service" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="Stop selected service"/>
                                <Button x:Name="BtnSvcRestart" Content="Restart Service" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="Restart selected service"/>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                                <Button x:Name="BtnSvcProperties" Content="Properties &amp; Dependencies..." Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="View service details, description and two-way dependencies (Enter / Double-Click)"/>
                                <Button x:Name="BtnSvcGoToProcess" Content="Select Process in Tree" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Select host process (svchost.exe) in Process Tree"/>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                                <TextBlock x:Name="TxtSvcSummary" Text="0 Services" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0"/>
                            </StackPanel>

                            <!-- Services Filter Box -->
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center" Height="24">
                                <DockPanel>
                                    <Path DockPanel.Dock="Left" Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"
                                          Fill="{DynamicResource BrushTextMuted}" Width="11" Height="11" Stretch="Uniform" Margin="6,0,2,0" VerticalAlignment="Center"/>
                                    <Button x:Name="BtnClearSearchServices" DockPanel.Dock="Right" Content="X" Width="18" Background="Transparent" BorderThickness="0" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" Cursor="Hand" ToolTip="Clear Filter (Esc)"/>
                                    <TextBox x:Name="TxtSearchServices" Width="180" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource BrushTextPrimary}" VerticalContentAlignment="Center" Padding="4,0" ToolTip="Filter services by Name, Display Name, PID, Status, or Account"/>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Services DataGrid -->
                    <DataGrid x:Name="GridServices"
                              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}"
                              Background="{DynamicResource BrushSurfaceBg}"
                              Foreground="{DynamicResource BrushTextPrimary}"
                              RowHeaderWidth="0" RowHeight="22" BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BrushHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="Height" Value="22"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BrushRowSelectedBg}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrushRowSelectedFg}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Column 1: Service Name -->
                            <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" SortMemberPath="Name" Width="160" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 2: Display Name -->
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" SortMemberPath="DisplayName" Width="260" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 3: Host PID -->
                            <DataGridTextColumn Header="Host PID" Binding="{Binding PIDFormatted}" SortMemberPath="PID" Width="75" ElementStyle="{StaticResource RightTabularText}"/>

                            <!-- Column 4: Status -->
                            <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Padding="6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Column 5: Startup Type -->
                            <DataGridTextColumn Header="Startup Type" Binding="{Binding StartType}" SortMemberPath="StartType" Width="100" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 6: Log On As -->
                            <DataGridTextColumn Header="Log On As" Binding="{Binding User}" SortMemberPath="User" Width="140" ElementStyle="{StaticResource EllipsisCellText}"/>

                            <!-- Column 7: Dependencies -->
                            <DataGridTextColumn Header="Dependencies" Binding="{Binding DependenciesFormatted}" SortMemberPath="Dependencies" Width="*" ElementStyle="{StaticResource EllipsisCellText}"/>
                        </DataGrid.Columns>

                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ContextMenuStyle}">
                                <MenuItem x:Name="CtxStartService" Header="Start Service"/>
                                <MenuItem x:Name="CtxStopService" Header="Stop Service"/>
                                <MenuItem x:Name="CtxRestartService" Header="Restart Service"/>
                                <Separator/>
                                <MenuItem x:Name="CtxServiceProperties" Header="Properties &amp; Dependencies..." InputGestureText="Enter" FontWeight="Bold"/>
                                <MenuItem x:Name="CtxGoToServiceProcess" Header="Select Host Process in Tree"/>
                                <Separator/>
                                <MenuItem x:Name="CtxCopyServiceName" Header="Copy Service Name"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
