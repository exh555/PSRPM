                                <Button x:Name="BtnSvcStop" Content="Stop Service" AutomationProperties.Name="Stop Selected Service" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="Stop selected service"/>
                                <Button x:Name="BtnSvcRestart" Content="Restart Service" AutomationProperties.Name="Restart Selected Service" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="Restart selected service"/>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
                                <Button x:Name="BtnSvcProperties" Content="Properties &amp; Dependencies..." AutomationProperties.Name="Service Properties and Dependencies" Style="{StaticResource ToolbarButtonStyle}" FontWeight="SemiBold" ToolTip="View service details, description and two-way dependencies (Enter / Double-Click)"/>
                                <Button x:Name="BtnSvcGoToProcess" Content="Select Process in Tree" AutomationProperties.Name="Select Service Host Process in Tree" Style="{StaticResource ToolbarButtonStyle}" ToolTip="Select host process (svchost.exe) in Process Tree"/>
                                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="4,2"/>
