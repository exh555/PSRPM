                                <Style TargetType="TextBlock" BasedOn="{StaticResource EllipsisCellText}">
                                    <Setter Property="ToolTip" Value="{Binding HostedServices}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn x:Name="ColCategory" Header="Category" Binding="{Binding Category}" SortMemberPath="Category" Width="82" Visibility="Collapsed" ElementStyle="{StaticResource EllipsisCellText}"/>
