                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushSparkBorder}" BorderThickness="1" CornerRadius="2" VerticalAlignment="Center" Height="{DynamicResource SearchBoxHeight}">
