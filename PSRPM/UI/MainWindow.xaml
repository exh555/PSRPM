                                </Border>
                                <TextBlock x:Name="TxtNetBannerDetail" Text="Per-process ETW telemetry is currently turned off." FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
