                    <DataGrid.ContextMenu>
                        <ContextMenu Style="{StaticResource ContextMenuStyle}">
                            <MenuItem x:Name="CtxProperties" Header="_Properties..." InputGestureText="Enter" FontWeight="SemiBold"/>
                            <MenuItem x:Name="CtxGoToParent" Header="Go to P_arent Process" ToolTip="Jump selection to the parent process that spawned this process"/>
                            <MenuItem x:Name="CtxExpandSubtree" Header="E_xpand Subtree"/>
                            <MenuItem x:Name="CtxCollapseSubtree" Header="Co_llapse Subtree"/>
                            <Separator/>
                            <MenuItem x:Name="CtxSuspend" Header="_Suspend Process"/>
                            <MenuItem x:Name="CtxResume" Header="R_esume Process"/>
                            <MenuItem x:Name="CtxSetPriority" Header="Set Pr_iority">
                                <MenuItem x:Name="CtxPrioIdle" Header="_Idle (Low)"/>
                                <MenuItem x:Name="CtxPrioBelow" Header="_Below Normal"/>
                                <MenuItem x:Name="CtxPrioNormal" Header="_Normal"/>
                                <MenuItem x:Name="CtxPrioAbove" Header="_Above Normal"/>
                                <MenuItem x:Name="CtxPrioHigh" Header="_High"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem x:Name="CtxEndProcess" Header="_Kill Process" InputGestureText="Del"/>
                            <MenuItem x:Name="CtxEndTree" Header="Kill Process _Tree" InputGestureText="Shift+Del"/>
                            <Separator/>
                            <MenuItem x:Name="CtxCreateDump" Header="Create _Dump">
                                <MenuItem x:Name="CtxCreateMiniDump" Header="Create _Minidump..." ToolTip="Create lightweight minidump on target host in %SystemRoot%\Temp\PSRPM_Dumps (or %LOCALAPPDATA%\PSRPM\Dumps)"/>
                                <MenuItem x:Name="CtxCreateFullDump" Header="Create _Full Memory Dump..." ToolTip="Create complete memory dump on target host in %SystemRoot%\Temp\PSRPM_Dumps (or %LOCALAPPDATA%\PSRPM\Dumps)"/>
                            </MenuItem>
                            <MenuItem x:Name="CtxCopySubmenu" Header="_Copy">
                                <MenuItem x:Name="CtxCopyName" Header="Copy Process _Name"/>
                                <MenuItem x:Name="CtxCopyPid" Header="Copy _PID"/>
                                <Separator/>
                                <MenuItem x:Name="CtxCopyCmdLine" Header="Copy _Command Line"/>
                                <MenuItem x:Name="CtxCopyPath" Header="Copy _Executable Path"/>
                            </MenuItem>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Centered Empty-State Overlay When Filters Match Zero Processes -->
                    <Border x:Name="ProcEmptyStateOverlay" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20,14" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="420">
                            <TextBlock x:Name="TxtProcEmptyTitle" Text="No processes match the active filter" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtProcEmptyHint" Text="Clear your search text or category filter to view all running processes." FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,10"/>
                            <Button x:Name="BtnProcEmptyClear" Content="Clear Filters (Esc)" AutomationProperties.Name="Clear Process Filters" HorizontalAlignment="Center" Padding="12,4" FontSize="11" FontWeight="SemiBold" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 2: Windows Services -->
            <TabItem Header="Services">
                <DockPanel Background="{DynamicResource BrushSurfaceBg}">
                    <!-- Services Action &amp; Filter Toolbar -->
                    <Border DockPanel.Dock="Top" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="{DynamicResource SubToolbarPadding}">
