<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PSRPM - Help &amp; Information Reference"
        Height="640" Width="840" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Key Combo Badge Style -->
        <Style x:Key="KeyBadge" TargetType="Border">
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="KeyBadgeText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Descriptive Shortcut Text Style -->
        <Style x:Key="ShortcutDescText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Section Header Text Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#0284C7"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>

        <!-- Info Label & Value Styles -->
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,8,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar with Icon, Title and Version Badge -->
        <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12,10" Margin="0,0,0,10">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#0284C7" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderBadge" Text="v1.1.1" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tachometer Vector Icon -->
                    <Grid Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12C20,14.4 18.9,16.5 17.2,17.9L15.8,16.5C17.2,15.3 18,13.7 18,12A6,6 0 0,0 12,6A6,6 0 0,0 6,12C6,13.7 6.8,15.3 8.2,16.5L6.8,17.9C5.1,16.5 4,14.4 4,12A8,8 0 0,1 12,4M12,8A4,4 0 0,0 8,12C8,13.1 8.5,14.1 9.3,14.7L13.4,10.6C13.2,10.2 13,9.8 13,9.4A1.4,1.4 0 0,1 14.4,8C14.8,8 15.2,8.2 15.6,8.4L17,7C15.6,5.8 13.9,5 12,5V8Z"
                              Fill="#0284C7" Stretch="Uniform"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PSRPM - PowerShell Remote Process Manager" FontWeight="Bold" FontSize="14" Foreground="#0F172A"/>
                        <TextBlock Text="Sysinternals Process Explorer Ergonomics over Fileless WinRM &amp; Local PowerShell" Foreground="#475569" FontSize="11" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Tab Control -->
        <TabControl x:Name="HelpTabControl" Grid.Row="1">
            <!-- TAB 1: KEYBOARD SHORTCUTS -->
            <TabItem Header="_Shortcuts" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Section: Navigation & Views -->
                        <TextBlock Text="Navigation &amp; View Controls" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+T" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Toggle between Hierarchical Process Tree and Flat List view" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+F" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Focus the instant search/filter box (preserves parent-child hierarchy in tree)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Esc" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Clear search filter and restore full process hierarchy with focus on grid" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Left Arrow" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Collapse branch in Tree View, or jump to parent process if leaf/collapsed" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Right Arrow" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Expand branch in Tree View, or jump to first child process if expanded" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+I" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Open System Information graphs modal (Summary, CPU, Memory, I/O)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+L" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="Toggle bottom Audit Trail &amp; Network Telemetry Console pane" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="7" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+D" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="Toggle between Clean Light (Sysinternals) and Precision Dark themes" Style="{StaticResource ShortcutDescText}"/>
                            </Grid>
                        </Border>

                        <!-- Section: Process Control & Operations -->
                        <TextBlock Text="Process Operations &amp; Inspection" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Enter / Dbl-Click" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Open 7-Tab Process Properties Inspector (Image, Perf, DLLs, Handles, TCP/IP, Services, Env)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Del" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Terminate selected process (KillProcess) with confirmation" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Shift+Del" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Terminate process tree (KillTree) with two-phase atomic suspension to avoid PID collisions" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Space" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Pause / resume real-time telemetry polling" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="F5" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Trigger immediate telemetry poll and differential UI sync" Style="{StaticResource ShortcutDescText}"/>
                            </Grid>
                        </Border>

                        <!-- Section: Multi-Host Tabbed Sessions -->
                        <TextBlock Text="Multi-Host Session Management" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,4" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+K" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Open Connect modal to switch the active host target or switch to Local mode" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+Shift+K" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open Connect modal in 'New Tab' mode (keep current target warm in standby)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+W" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Close the current host session tab and switch to the nearest tab" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+Tab" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Cycle forward to next open host session tab (&lt; 5ms in-place swap)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+Shift+Tab" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Cycle backward to previous open host session tab" Style="{StaticResource ShortcutDescText}"/>
                            </Grid>
                        </Border>

                        <!-- Section: Application & Exports -->
                        <TextBlock Text="File &amp; Application" Style="{StaticResource SectionHeader}"/>
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="3" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Ctrl+S" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Export current process snapshot to CSV format" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="F1" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Open this Help, Keyboard Shortcuts &amp; Reference modal" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource KeyBadge}"><TextBlock Text="Alt+F4" Style="{StaticResource KeyBadgeText}"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="Close and cleanly terminate PSRPM sessions and runspaces" Style="{StaticResource ShortcutDescText}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: ARCHITECTURE & SAFETY -->
            <TabItem Header="_Architecture &amp; Safety" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Core Architectural Pillars &amp; Performance Budget" Style="{StaticResource SectionHeader}"/>

                        <!-- Card 1: 100% Fileless Security -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="100% Fileless &amp; EDR-Safe Security Posture" FontWeight="Bold" FontSize="13" Foreground="#16A34A"/>
                                <TextBlock Text="- Zero csc.exe compiler child processes and zero temporary .dll or .cs files written to %TEMP% on local or remote endpoints.&#x0a;- Win32 / NTAPI P/Invoke signatures emitted directly into memory via in-memory .NET Reflection.Emit (AssemblyBuilderAccess.Run).&#x0a;- ViewModels implemented as pure Windows PowerShell 5.1 AST classes (INotifyPropertyChanged)."
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 2: Ultra-Low Remote Target Overhead -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Ultra-Low Target Impact (&lt; 0.25% CPU, 2-10 ms Collection)" FontWeight="Bold" FontSize="13" Foreground="#0284C7"/>
                                <TextBlock Text="- Queries ntdll!NtQuerySystemInformation(5) and kernel32!GlobalMemoryStatusEx in a single kernel transition into persistent 512 KB unmanaged memory.&#x0a;- Zero WmiPrvSE.exe CPU spikes, zero N+1 CIM GetOwner() roundtrips, and zero 5-second UI hangs from $p.Responding.&#x0a;- Dead process tokens, CPU baselines, and state maps are synchronously evicted every tick to eliminate memory growth."
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 3: Differential Network Wire Protocol -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Differential GZIP Wire Streaming (~1.1 - 1.8 KB/s)" FontWeight="Bold" FontSize="13" Foreground="#CA8A04"/>
                                <TextBlock Text="- Static metadata (Path, CommandLine, User, Description, Company, Architecture) transmitted only once per process upon spawn (keyed by PID + CreateTime).&#x0a;- Subsequent ticks transmit only changed dynamic metrics ([PID, CPU, WorkingSet, PrivateBytes, Threads, Handles, Status]) compressed with in-memory GZIP.&#x0a;- 80%+ network bandwidth reduction compared to standard WinRM CLIXML object serialization."
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Zero-Leak Local Workstation Memory -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Zero-Leak Memory Architecture &amp; In-Place Reconciler" FontWeight="Bold" FontSize="13" Foreground="#7C3AED"/>
                                <TextBlock Text="- Telemetry sparkline and system information histories stored in strictly bounded Queue[double] circular ring buffers (120 samples = &lt; 12 KB per session).&#x0a;- Live UI DataGrids reconcile in-place via dirty-checked INotifyPropertyChanged. The collection is never cleared, ensuring scroll position, selected rows, and expanders remain solid.&#x0a;- Inactive tabs in the Multi-Host session bar drop to 0 KB/s wire and 0% CPU in standby."
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Card 5: Safe Bulk Handle Enumeration -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Kernel Named-Pipe Deadlock Prevention" FontWeight="Bold" FontSize="13" Foreground="#DC2626"/>
                                <TextBlock Text="- When inspecting open kernel handles, synchronous File and Named-Pipe objects are bypassed during NtQueryObject(ObjectNameInformation) calls.&#x0a;- Completely prevents kernel deadlocks and frozen runspaces on Chromium / msedgewebview2.exe Mojo IPC pipes."
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: REMOTING & CONNECTIVITY -->
            <TabItem Header="_Connectivity" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Remoting &amp; Host Connectivity Guide" Style="{StaticResource SectionHeader}"/>

                        <!-- Remote WinRM Guide -->
                        <GroupBox Header="1. Remote Computer via WinRM (-ComputerName)" BorderBrush="#CBD5E1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="PSRPM establishes a single persistent PowerShell PSSession over WinRM (TCP 5985 for HTTP or 5986 for HTTPS/SSL). No secondary RPC, DCOM, or SMB ports are opened." TextWrapping="Wrap"/>
                                <TextBlock Text="Target Host Configuration Requirements:" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <Border Background="#F1F5F9" Padding="6" CornerRadius="3">
                                    <TextBlock Text="# Enable PowerShell Remoting on the remote computer (run as Administrator):&#x0a;Enable-PSRemoting -Force" FontFamily="Consolas" FontSize="11"/>
                                </Border>
                                <TextBlock Text="Workgroup or Non-Domain Endpoints:" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <Border Background="#F1F5F9" Padding="6" CornerRadius="3">
                                    <TextBlock Text="# On your local workstation (elevated), add target IP to TrustedHosts:&#x0a;Set-Item WSMan:\localhost\Client\TrustedHosts -Value '10.20.30.40' -Concatenate -Force" FontFamily="Consolas" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Local Only Guide -->
                        <GroupBox Header="2. Local Host Execution (-LocalOnly / -Local)" BorderBrush="#CBD5E1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="You can run PSRPM locally without WinRM remoting, network listeners, or administrative privileges:" TextWrapping="Wrap"/>
                                <Border Background="#F1F5F9" Padding="6" CornerRadius="3" Margin="0,6,0,0">
                                    <TextBlock Text="Start-PSRPM -LocalOnly&#x0a;# Or using alias:&#x0a;psrpm -Local" FontFamily="Consolas" FontSize="11"/>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- Process Color Legend -->
                        <GroupBox Header="3. Semantic Row Color Legend" BorderBrush="#CBD5E1" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#FFE4E6" BorderBrush="#FDA4AF" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,2,8,2"><TextBlock Text="Services" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/></Border>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="Processes hosting Windows background services (svchost.exe, services.exe)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="1" Grid.Column="0" Background="#E0E7FF" BorderBrush="#A5B4FC" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,2,8,2"><TextBlock Text="Own / User" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/></Border>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Interactive processes running within the operator's logon session" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="2" Grid.Column="0" Background="#67E8F9" BorderBrush="#06B6D4" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,2,8,2"><TextBlock Text="Packaged / WebView" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/></Border>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="AppContainer, UWP, and Chromium msedgewebview2.exe child processes" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="3" Grid.Column="0" Background="#CBD5E1" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,2,8,2"><TextBlock Text="Suspended" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/></Border>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Processes whose threads are suspended (WaitReason == Suspended)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="4" Grid.Column="0" Background="#86EFAC" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,2,8,2"><TextBlock Text="New (1 Tick)" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/></Border>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="Newly spawned process (flashes lime green for one refresh tick)" Style="{StaticResource ShortcutDescText}"/>

                                <Border Grid.Row="5" Grid.Column="0" Background="#FCA5A5" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="0,2,8,2"><TextBlock Text="Exiting (1 Tick)" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A"/></Border>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="Terminated process before removal from tree (flashes crimson for one tick)" Style="{StaticResource ShortcutDescText}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: ABOUT & SYSTEM -->
            <TabItem Header="_About" Padding="12,4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <TextBlock Text="About PSRPM" Style="{StaticResource SectionHeader}"/>

                        <!-- App Identity Card -->
                        <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Vector Logo -->
                                <Grid Grid.Column="0" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <Path Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12C20,14.4 18.9,16.5 17.2,17.9L15.8,16.5C17.2,15.3 18,13.7 18,12A6,6 0 0,0 12,6A6,6 0 0,0 6,12C6,13.7 6.8,15.3 8.2,16.5L6.8,17.9C5.1,16.5 4,14.4 4,12A8,8 0 0,1 12,4M12,8A4,4 0 0,0 8,12C8,13.1 8.5,14.1 9.3,14.7L13.4,10.6C13.2,10.2 13,9.8 13,9.4A1.4,1.4 0 0,1 14.4,8C14.8,8 15.2,8.2 15.6,8.4L17,7C15.6,5.8 13.9,5 12,5V8Z"
                                          Fill="#0284C7" Stretch="Uniform"/>
