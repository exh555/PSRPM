<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Properties"
        Height="620" Width="740" MinHeight="520" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="RightTabularText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Multi-Tab Deep Inspector (Sysinternals Process Explorer Layout) -->
        <TabControl x:Name="PropTabControl" Grid.Row="0">
            <!-- TAB 1: Image (Matches Sysinternals Process Explorer Image Tab) -->
            <TabItem Header="Image">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Image File GroupBox -->
                        <GroupBox Grid.Row="0" Header="Image File" Padding="10,8" Margin="0,0,0,12" BorderBrush="#CBD5E1">
                            <StackPanel>
                                <!-- Icon + Description + Company + PID Pill -->
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Path Data="M3,2H13L17,6V18C17,19.1 16.1,20 15,20H3C1.9,20 1,19.1 1,18V4C1,2.9 1.9,2 3,2M12,3.5V7H15.5L12,3.5M5,9V11H13V9H5M5,13V15H10V13H5Z"
                                              Fill="#64748B" Width="26" Height="26" Stretch="Uniform"/>
                                        <Image x:Name="PropIcon" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PropDescription" Text="Loading..." FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock x:Name="PropCompany" Text="N/A" Foreground="#475569" FontSize="11"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="3" Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock x:Name="PropHeaderPid" Text="PID: 0" FontWeight="Bold" Typography.NumeralAlignment="Tabular"/>
                                    </Border>
                                </Grid>

                                <!-- Version & Build Time -->
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="85"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="75"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Version:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropVersion" Grid.Column="1" Text="N/A" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="2" Text="Build Time:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropBuildTime" Grid.Column="3" Text="N/A"/>
                                </Grid>

                                <!-- Path + Copy -->
                                <TextBlock Text="Path:" Foreground="#475569" Margin="0,6,0,2"/>
                                <DockPanel>
                                    <Button x:Name="BtnCopyPath" DockPanel.Dock="Right" Content="Copy Path" Width="78" Margin="6,0,0,0" Padding="4,2"/>
                                    <TextBox x:Name="PropPath" IsReadOnly="True" Padding="4,3" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                </DockPanel>

                                <!-- Command Line + Copy -->
                                <TextBlock Text="Command line:" Foreground="#475569" Margin="0,6,0,2"/>
                                <DockPanel>
                                    <Button x:Name="BtnCopyCmd" DockPanel.Dock="Right" Content="Copy Cmd" Width="78" Margin="6,0,0,0" Padding="4,2"/>
                                    <TextBox x:Name="PropCmdLine" IsReadOnly="True" Padding="4,3" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                                </DockPanel>

                                <!-- Current Directory -->
                                <TextBlock Text="Current directory:" Foreground="#475569" Margin="0,6,0,2"/>
                                <TextBox x:Name="PropWorkDir" IsReadOnly="True" Text="Querying remote PEB..." Padding="4,3" Background="#F8FAFC" BorderBrush="#CBD5E1"/>

                                <!-- Autostart Location -->
                                <TextBlock Text="Autostart Location:" Foreground="#475569" Margin="0,6,0,2"/>
                                <TextBox x:Name="PropAutostart" IsReadOnly="True" Text="n/a" Padding="4,3" Background="#F8FAFC" BorderBrush="#CBD5E1"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Lower Metadata + Right Action Stack -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="125"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="4,0,12,0" VerticalAlignment="Top">
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Parent:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropParentPid" Grid.Column="1" Text="N/A" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="User:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropUser" Grid.Column="1" Text="N/A"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="175"/>
                                        <ColumnDefinition Width="55"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Started:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropStartTime" Grid.Column="1" Text="N/A"/>
                                    <TextBlock Grid.Column="2" Text="Image:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropArch" Grid.Column="3" Text="64-bit (x64)" FontWeight="SemiBold"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="95"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Verified Signer:" Foreground="#475569"/>
                                    <TextBlock x:Name="PropSignature" Grid.Column="1" Text="Click 'Verify' to check Authenticode signature" Foreground="#0284C7" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>

                            <!-- Right Action Stack -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button x:Name="BtnVerifySig" Content="Verify" Height="26" Margin="0,0,0,6" ToolTip="Verify Authenticode Digital Signature on Target"/>
                                <Button x:Name="BtnSuspendResume" Content="Suspend" Height="26" Margin="0,0,0,6" ToolTip="Suspend or Resume Process"/>
                                <Button x:Name="BtnPropCreateDump" Content="Create Dump..." Height="26" Margin="0,0,0,6" ToolTip="Generate Process Memory Dump in C:\temp on Target Host">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="MenuPropMiniDump" Header="Create Minidump..."/>
                                            <MenuItem x:Name="MenuPropFullDump" Header="Create Full Memory Dump..."/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button x:Name="BtnPropEndProcess" Content="Kill Process" Height="26" Margin="0,0,0,6" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#F87171" FontWeight="SemiBold"/>
                                <Button x:Name="BtnPropEndTree" Content="Kill Process Tree" Height="26" Background="#FECACA" Foreground="#7F1D1D" BorderBrush="#EF4444" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Performance & Ancestry -->
            <TabItem Header="Performance">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <GroupBox Header="CPU &amp; Handle Counters" Padding="8" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock x:Name="PropCpu" Text="CPU Usage: 0.0%" FontWeight="Bold" FontSize="13" Foreground="#16A34A" Margin="0,0,0,4"/>
                                <TextBlock x:Name="PropTotalCpuTime" Text="Total Processor Time: 00:00:00.000" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropKernelUserTime" Text="Kernel: 00:00:00 | User: 00:00:00" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropCycles" Text="Cycles: 0" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropThreadsHandles" Text="Handles: 0 (GDI: 0, USER: 0)" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Memory &amp; I/O Counters" Padding="8" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock x:Name="PropPrivateBytes" Text="Private Bytes: 0 K" FontWeight="Bold" FontSize="13" Foreground="#CA8A04" Margin="0,0,0,4" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropRam" Text="Working Set: 0 K (Peak: 0 K)" FontWeight="SemiBold" Foreground="#EA580C" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropVirtualPageFaults" Text="Virtual Size: 0 MB | Page Faults: 0" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropPools" Text="Paged Pool: 0 K | Non-Paged Pool: 0 K" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropIoCounters" Text="I/O Reads: 0 K | Writes: 0 K" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                            </StackPanel>
                        </GroupBox>
                    </UniformGrid>

                    <!-- Process Hierarchy & Live Descendant Tree -->
                    <GroupBox Grid.Row="1" Header="Process Ancestry &amp; Descendant Tree" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Tabular Column Header Strip -->
                            <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1,1,1,0" CornerRadius="3,3,0,0" Padding="6,4">
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="TreeHeaderScrollSpacer" DockPanel.Dock="Right" Width="14" Visibility="Collapsed"/>
                                    <Grid DockPanel.Dock="Right" Margin="0,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="105"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PID" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="CPU" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="Private Bytes" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="3" Text="Working Set" FontWeight="SemiBold" Foreground="#475569" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </Grid>
                                    <TextBlock Text="Process" FontWeight="SemiBold" Foreground="#475569" Margin="22,0,0,0"/>
                                </DockPanel>
                            </Border>

                            <!-- Process Ancestry TreeView (Strict Column Alignment across All Indentation Depths) -->
                            <TreeView Grid.Row="1" x:Name="PropProcessTree" BorderThickness="1" BorderBrush="#CBD5E1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="2,3" Background="White">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsNodeExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsTargetNode, Mode=OneWay}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Vector Expander Arrow Glyph -->
                                                        <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" VerticalAlignment="Center" Margin="2,0,0,0">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="UIElement.Focusable" Value="false"/>
                                                                    <Setter Property="FrameworkElement.Width" Value="14"/>
                                                                    <Setter Property="FrameworkElement.Height" Value="14"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Width="14" Height="14" Background="Transparent">
                                                                                    <Path x:Name="ExpandPath" Fill="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L0,8 L6,4 Z"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="ExpandPath" Property="Data" Value="M0,2 L8,2 L4,7 Z"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>

                                                        <!-- Stretched Content Host -->
                                                        <Border Grid.Column="1" x:Name="Bd" HorizontalAlignment="Stretch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                        </Border>

                                                        <!-- Children Subtree Host -->
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="false">
                                                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Border Background="{Binding NodeBackground}" BorderBrush="{Binding NodeBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="0,1" HorizontalAlignment="Stretch">
                                            <DockPanel LastChildFill="True">
                                                <!-- Right: Formatted Tabular Metrics Columns -->
                                                <Grid DockPanel.Dock="Right" Margin="0,0,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="105"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PID}" FontWeight="SemiBold" Foreground="#0F172A" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CPUFormatted}" Foreground="#16A34A" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PrivateBytesFormatted}" Foreground="#CA8A04" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding MemoryFormatted}" Foreground="#EA580C" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Left: SELECTED Badge + Process Name -->
                                                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                                    <Border DockPanel.Dock="Left" Background="#0284C7" CornerRadius="2" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding TargetBadgeVisibility}">
                                                        <TextBlock Text="SELECTED" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="{Binding NodeFontWeight}" Foreground="#0F172A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DockPanel>
                                        </Border>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- TAB 3: DLLs (Loaded Modules - Sysinternals Process Explorer DLL View) -->
            <TabItem Header="DLLs">
                <DataGrid x:Name="GridPropDlls" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="22" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="145" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="195"/>
                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="140"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="105"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="75" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Base Address" Binding="{Binding BaseAddress}" Width="115"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 4: Handles (Open Kernel Objects - Sysinternals Process Explorer Handle View) -->
            <TabItem Header="Handles">
                <DataGrid x:Name="GridPropHandles" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="22" Margin="4">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CtxPropCloseHandle" Header="Close Selected Handle..." InputGestureText="Del"/>
                            <Separator/>
                            <MenuItem x:Name="CtxPropCopyHandleName" Header="Copy Object Name" InputGestureText="Ctrl+C"/>
                            <MenuItem x:Name="CtxPropCopyHandleValue" Header="Copy Handle Value"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="115" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="85" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Access" Binding="{Binding Access}" Width="95" ElementStyle="{StaticResource RightTabularText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 5: TCP/IP -->
            <TabItem Header="TCP/IP">
                <DataGrid x:Name="GridNetConnections" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="22" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="75"/>
                        <DataGridTextColumn Header="Local Address" Binding="{Binding LocalEndpoint}" Width="210"/>
                        <DataGridTextColumn Header="Remote Address" Binding="{Binding RemoteEndpoint}" Width="210"/>
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 6: Services (Hosted Services in svchost.exe) -->
            <TabItem Header="Services">
                <DataGrid x:Name="GridPropServices" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="22" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="260"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Startup Type" Binding="{Binding StartType}" Width="95"/>
                        <DataGridTextColumn Header="Account" Binding="{Binding User}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 7: Environment -->
            <TabItem Header="Environment">
                <DataGrid x:Name="GridPropEnv" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeaderWidth="0" RowHeight="22" Margin="4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Variable" Binding="{Binding Key}" Width="210" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Dialog Footer -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="PropHeaderName" Text="" Visibility="Collapsed"/>
            <Button x:Name="BtnRefreshInspector" Content="Refresh Inspector" Width="115" Height="26" Margin="0,0,8,0"/>
            <Button x:Name="BtnCloseProp" Content="OK" Width="88" Height="26" IsDefault="True" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
