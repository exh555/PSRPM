<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Properties"
        Height="660" Width="840" MinHeight="540" MinWidth="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushWindowBg}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Default Clean Light Theme (Sysinternals Process Explorer Refined) -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushToolbarBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BrushSurfaceBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushHeaderBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushTreeLine" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushRowHover" Color="#220284C7"/>
        <SolidColorBrush x:Key="BrushRowSelectedBg" Color="#006CBE"/>
        <SolidColorBrush x:Key="BrushRowSelectedFg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBorder" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushMenuBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushMenuBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushMenuHover" Color="#F1F5F9"/>

        <!-- Right-Aligned Tabular Numeric TextBlock Style -->
        <Style x:Key="RightTabularText" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0,6,0"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>

        <!-- Truncated Cell Text -->
        <Style x:Key="EllipsisCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0,4,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- Standard Button Style -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushToolbarBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0284C7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushBorderSubtle}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Flat Group Container Card Style -->
        <Style x:Key="FlatCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Vertical Left Navigation TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3,0,0,3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushRowHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0284C7"/>
                                <Setter TargetName="TabBorder" Property="BorderThickness" Value="3,0,0,0"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean TabControl Style with Flat Container -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Left Vertical Navigation Bar -->
                            <Border Grid.Column="0" Background="{DynamicResource BrushToolbarBg}"
                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                    BorderThickness="0,0,1,0" Padding="4,6">
                                <TabPanel IsItemsHost="True" Background="Transparent" VerticalAlignment="Top"/>
                            </Border>
                            <!-- Right Tab Content Surface -->
                            <Border Grid.Column="1" Background="{DynamicResource BrushSurfaceBg}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}"
                                                  SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Modern Process Header Banner Card -->
        <Border Grid.Row="0" Background="{DynamicResource BrushToolbarBg}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Process Executable Icon (with vector fallback) -->
                <Grid Grid.Column="0" Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Path Data="M3,2H13L17,6V18C17,19.1 16.1,20 15,20H3C1.9,20 1,19.1 1,18V4C1,2.9 1.9,2 3,2M12,3.5V7H15.5L12,3.5M5,9V11H13V9H5M5,13V15H10V13H5Z"
                          Fill="{DynamicResource BrushTextMuted}" Width="30" Height="30" Stretch="Uniform"/>
                    <Image x:Name="PropIcon" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- Process Name, Description & Company -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="PropHeaderName" Text="Process" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PropHeaderPid" Text="PID: 0" FontWeight="Bold" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Border>
                        <Border Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PropArch" Text="64-bit (x64)" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="PropDescription" Text="Loading process description..." FontSize="11.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="PropCompany" Text="N/A" FontSize="10.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Authenticode Signature Verification Badge -->
                <Border Grid.Column="2" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnVerifySig" Content="Verify" Style="{StaticResource ActionButtonStyle}" Height="22" Padding="6,1" FontSize="10" Margin="0,0,8,0" ToolTip="Verify Authenticode Digital Signature on Target"/>
                        <TextBlock x:Name="PropSignature" Text="Click 'Verify' to check signature" Foreground="#0284C7" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Main Deep Inspector Workspace (Vertical Left Navigation Tabs) -->
        <TabControl x:Name="PropTabControl" Grid.Row="1" TabStripPlacement="Left">

            <!-- TAB 1: Image & Identity -->
            <TabItem Header="Image">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                    <StackPanel>
                        <!-- Image File & Paths Card -->
                        <Border Style="{StaticResource FlatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Executable &amp; PEB Metadata" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                <!-- Path + Copy -->
                                <TextBlock Text="Executable Path:" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,2,0,2"/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnCopyPath" DockPanel.Dock="Right" Content="Copy Path" Style="{StaticResource ActionButtonStyle}" Height="24" Width="78" Margin="6,0,0,0"/>
                                    <TextBox x:Name="PropPath" IsReadOnly="True" Padding="5,3" Background="{DynamicResource BrushToolbarBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}"/>
                                </DockPanel>

                                <!-- Command Line + Copy -->
                                <TextBlock Text="Command Line:" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,2,0,2"/>
                                <DockPanel Margin="0,0,0,6">
                                    <Button x:Name="BtnCopyCmd" DockPanel.Dock="Right" Content="Copy Cmd" Style="{StaticResource ActionButtonStyle}" Height="24" Width="78" Margin="6,0,0,0"/>
                                    <TextBox x:Name="PropCmdLine" IsReadOnly="True" Padding="5,3" Background="{DynamicResource BrushToolbarBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}"/>
                                </DockPanel>

                                <!-- Current Directory -->
                                <TextBlock Text="Current Directory:" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,2,0,2"/>
                                <TextBox x:Name="PropWorkDir" IsReadOnly="True" Text="Querying remote PEB..." Padding="5,3" Background="{DynamicResource BrushToolbarBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,6"/>

                                <!-- Autostart Location -->
                                <TextBlock Text="Autostart Location:" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="0,2,0,2"/>
                                <TextBox x:Name="PropAutostart" IsReadOnly="True" Text="n/a" Padding="5,3" Background="{DynamicResource BrushToolbarBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushBorderSubtle}"/>
                            </StackPanel>
                        </Border>

                        <!-- Execution Context & Binary Properties Card -->
                        <Border Style="{StaticResource FlatCardStyle}">
                            <StackPanel>
                                <TextBlock Text="Execution Context &amp; Binary Details" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Parent Process:" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock x:Name="PropParentPid" Grid.Column="1" Text="N/A" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="User Account:" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock x:Name="PropUser" Grid.Column="3" Text="N/A" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="File Version:" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock x:Name="PropVersion" Grid.Column="1" Text="N/A" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    <TextBlock Grid.Column="2" Text="Linker Build:" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock x:Name="PropBuildTime" Grid.Column="3" Text="N/A" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>

                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Started At:" Foreground="{DynamicResource BrushTextMuted}"/>
                                    <TextBlock x:Name="PropStartTime" Grid.Column="1" Text="N/A" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Performance & Focused Ancestry Tree -->
            <TabItem Header="Performance">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Metric Counter Cards -->
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <!-- CPU & Handles Card -->
                        <Border Style="{StaticResource FlatCardStyle}" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="CPU &amp; Processor Counters" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="PropCpu" Text="CPU Usage: 0.0%" FontWeight="Bold" FontSize="13" Foreground="#16A34A" Margin="0,0,0,4"/>
                                <TextBlock x:Name="PropTotalCpuTime" Text="Total Processor Time: 00:00:00.000" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock x:Name="PropKernelUserTime" Text="Kernel: 00:00:00 | User: 00:00:00" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock x:Name="PropCycles" Text="Cycles: 0" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock x:Name="PropThreadsHandles" Text="Handles: 0 (GDI: 0, USER: 0)" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>

                        <!-- Memory & I/O Card -->
                        <Border Style="{StaticResource FlatCardStyle}" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Memory &amp; Storage Counters" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="PropPrivateBytes" Text="Private Bytes: 0 K" FontWeight="Bold" FontSize="13" Foreground="#CA8A04" Margin="0,0,0,4" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropRam" Text="Working Set: 0 K (Peak: 0 K)" FontWeight="SemiBold" Foreground="#EA580C" Margin="0,2" Typography.NumeralAlignment="Tabular"/>
                                <TextBlock x:Name="PropVirtualPageFaults" Text="Virtual Size: 0 MB | Page Faults: 0" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextSecondary}"/>
                                <TextBlock x:Name="PropPools" Text="Paged Pool: 0 K | Non-Paged Pool: 0 K" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextMuted}"/>
                                <TextBlock x:Name="PropIoCounters" Text="I/O Reads: 0 K | Writes: 0 K" Margin="0,2" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource BrushTextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Focused Process Ancestry & Descendant Tree -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Column Header Strip -->
                            <Border Grid.Row="0" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="6,4">
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="TreeHeaderScrollSpacer" DockPanel.Dock="Right" Width="14" Visibility="Collapsed"/>
                                    <Grid DockPanel.Dock="Right" Margin="0,0,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="65"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="95"/>
                                            <ColumnDefinition Width="105"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PID" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="CPU" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="2" Text="Private Bytes" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="3" Text="Working Set" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </Grid>
                                    <TextBlock Text="Focused Process Hierarchy" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="8,0,0,0"/>
                                </DockPanel>
                            </Border>

                            <!-- Ancestry TreeView -->
                            <TreeView Grid.Row="1" x:Name="PropProcessTree" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="2,3">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="IsExpanded" Value="{Binding IsNodeExpanded, Mode=TwoWay}"/>
                                        <Setter Property="IsSelected" Value="{Binding IsTargetNode, Mode=OneWay}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="TreeViewItem">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Vector Expander Arrow Glyph -->
                                                        <ToggleButton x:Name="Expander" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" VerticalAlignment="Center" Margin="2,0,0,0">
                                                            <ToggleButton.Style>
                                                                <Style TargetType="ToggleButton">
                                                                    <Setter Property="UIElement.Focusable" Value="false"/>
                                                                    <Setter Property="FrameworkElement.Width" Value="14"/>
                                                                    <Setter Property="FrameworkElement.Height" Value="14"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Width="14" Height="14" Background="Transparent">
                                                                                    <Path x:Name="ExpandPath" Fill="{DynamicResource BrushTreeLine}" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L0,8 L6,4 Z"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="ExpandPath" Property="Data" Value="M0,2 L8,2 L4,7 Z"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </ToggleButton.Style>
                                                        </ToggleButton>

                                                        <!-- Stretched Content Host -->
                                                        <Border Grid.Column="1" x:Name="Bd" HorizontalAlignment="Stretch" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Stretch"/>
                                                        </Border>

                                                        <!-- Children Subtree Host -->
                                                        <ItemsPresenter x:Name="ItemsHost" Grid.Column="1" Grid.Row="1"/>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="HasItems" Value="false">
                                                             <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <Border Background="{Binding NodeBackground}" BorderBrush="{Binding NodeBorderBrush}" BorderThickness="1" CornerRadius="2" Padding="4,2" Margin="0,1" HorizontalAlignment="Stretch">
                                            <DockPanel LastChildFill="True">
                                                <Grid DockPanel.Dock="Right" Margin="0,0,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="65"/>
                                                        <ColumnDefinition Width="60"/>
                                                        <ColumnDefinition Width="95"/>
                                                        <ColumnDefinition Width="105"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding PID}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CPUFormatted}" Foreground="#16A34A" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PrivateBytesFormatted}" Foreground="#CA8A04" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding MemoryFormatted}" Foreground="#EA580C" HorizontalAlignment="Right" Margin="0,0,6,0" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                                                </Grid>
                                                <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                                    <Border DockPanel.Dock="Left" Background="#0284C7" CornerRadius="2" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding TargetBadgeVisibility}">
                                                        <TextBlock Text="SELECTED" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontWeight="{Binding NodeFontWeight}" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DockPanel>
                                        </Border>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: Loaded DLLs (On-Demand Lazy Modules) -->
            <TabItem Header="DLLs">
                <DataGrid x:Name="GridPropDlls" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" RowHeaderWidth="0" RowHeight="22" Margin="6" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Module Name" Binding="{Binding Name}" Width="150" FontWeight="SemiBold" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="200" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Company Name" Binding="{Binding CompanyName}" Width="145" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="105" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="80" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Base Address" Binding="{Binding BaseAddress}" Width="120" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" ElementStyle="{StaticResource EllipsisCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 4: Handles (On-Demand Lazy Kernel Objects) -->
            <TabItem Header="Handles">
                <DataGrid x:Name="GridPropHandles" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" RowHeaderWidth="0" RowHeight="22" Margin="6" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CtxPropCloseHandle" Header="Close Selected Handle..." InputGestureText="Del"/>
                            <Separator/>
                            <MenuItem x:Name="CtxPropCopyHandleName" Header="Copy Object Name" InputGestureText="Ctrl+C"/>
                            <MenuItem x:Name="CtxPropCopyHandleValue" Header="Copy Handle Value"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Object Type" Binding="{Binding Type}" Width="120" FontWeight="SemiBold" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Object Name" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Handle" Binding="{Binding Handle}" Width="90" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Access Mask" Binding="{Binding Access}" Width="100" ElementStyle="{StaticResource RightTabularText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 5: TCP/IP Sockets -->
            <TabItem Header="TCP/IP">
                <DataGrid x:Name="GridNetConnections" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" RowHeaderWidth="0" RowHeight="22" Margin="6" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Local Address:Port" Binding="{Binding LocalEndpoint}" Width="220" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Remote Address:Port" Binding="{Binding RemoteEndpoint}" Width="220" ElementStyle="{StaticResource RightTabularText}"/>
                        <DataGridTextColumn Header="Socket State" Binding="{Binding State}" Width="*" ElementStyle="{StaticResource EllipsisCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 6: Hosted Windows Services -->
            <TabItem Header="Services">
                <DataGrid x:Name="GridPropServices" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" RowHeaderWidth="0" RowHeight="22" Margin="6" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service Name" Binding="{Binding Name}" Width="150" FontWeight="SemiBold" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="260" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                        <DataGridTextColumn Header="Startup Type" Binding="{Binding StartType}" Width="100"/>
                        <DataGridTextColumn Header="Log On Account" Binding="{Binding User}" Width="*" ElementStyle="{StaticResource EllipsisCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- TAB 7: Environment Variables -->
            <TabItem Header="Environment">
                <DataGrid x:Name="GridPropEnv" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BrushBorderSubtle}" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" RowHeaderWidth="0" RowHeight="22" Margin="6" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Variable Name" Binding="{Binding Key}" Width="220" FontWeight="SemiBold" ElementStyle="{StaticResource EllipsisCellText}"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource EllipsisCellText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Persistent Action Bar & Dialog Controls -->
        <Border Grid.Row="2" Background="{DynamicResource BrushToolbarBg}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Process Control Action Buttons (Accessible from ANY Tab) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSuspendResume" Content="Suspend" Style="{StaticResource ActionButtonStyle}" Height="28" Margin="0,0,6,0" ToolTip="Suspend or Resume Target Process"/>
                    <Button x:Name="BtnPropCreateDump" Content="Create Dump..." Style="{StaticResource ActionButtonStyle}" Height="28" Margin="0,0,6,0" ToolTip="Generate Process Memory Dump in C:\temp on Target Host">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="MenuPropMiniDump" Header="Create Minidump..."/>
                                <MenuItem x:Name="MenuPropFullDump" Header="Create Full Memory Dump..."/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="BtnPropEndProcess" Content="Kill Process" Height="28" Padding="12,3" Margin="0,0,6,0" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#F87171" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" ToolTip="Terminate selected process (Del)"/>
                    <Button x:Name="BtnPropEndTree" Content="Kill Process Tree" Height="28" Padding="12,3" Background="#FECACA" Foreground="#7F1D1D" BorderBrush="#EF4444" BorderThickness="1" FontWeight="SemiBold" Cursor="Hand" ToolTip="Atomically terminate process and entire descendant tree (Shift+Del)"/>
                </StackPanel>

                <!-- Right: Navigation & Close Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnRefreshInspector" Content="Refresh" Style="{StaticResource ActionButtonStyle}" Height="28" Width="82" Margin="0,0,8,0" ToolTip="Re-query target metadata and telemetry"/>
                    <Button x:Name="BtnCloseProp" Content="Close" Style="{StaticResource ActionButtonStyle}" Height="28" Width="78" IsDefault="True" ToolTip="Close Inspector Window"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>