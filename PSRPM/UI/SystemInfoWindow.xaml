<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Information"
        Width="790" Height="640" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushWindowBg}" Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="Segoe UI" FontSize="11.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <!-- Default Clean Light Fallback Brushes -->
        <SolidColorBrush x:Key="BrushWindowBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="BrushToolbarBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="BrushSurfaceBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushHeaderBg" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="BrushBorderSubtle" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushTextSecondary" Color="#334155"/>
        <SolidColorBrush x:Key="BrushTextMuted" Color="#64748B"/>
        <SolidColorBrush x:Key="BrushSparkBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushSparkBorder" Color="#94A3B8"/>
        <SolidColorBrush x:Key="BrushSparkGrid" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="BrushAccent" Color="#0284C7"/>
        <SolidColorBrush x:Key="BrushNetRxStroke" Color="#0284C7"/>
        <SolidColorBrush x:Key="BrushNetRxFill" Color="#440284C7"/>
        <SolidColorBrush x:Key="BrushNetTxStroke" Color="#EA580C"/>
        <SolidColorBrush x:Key="BrushNetTxFill" Color="#44EA580C"/>
        <SolidColorBrush x:Key="BrushGaugeCpuFill" Color="#86EFAC"/>
        <SolidColorBrush x:Key="BrushGaugeCpuArea" Color="#8886EFAC"/>
        <SolidColorBrush x:Key="BrushGaugeCpuStroke" Color="#16A34A"/>
        <SolidColorBrush x:Key="BrushGaugeKernelFill" Color="#FCA5A5"/>
        <SolidColorBrush x:Key="BrushGaugeKernelArea" Color="#AAFCA5A5"/>
        <SolidColorBrush x:Key="BrushGaugeKernelStroke" Color="#DC2626"/>
        <SolidColorBrush x:Key="BrushGaugeCommitFill" Color="#D4D47A"/>
        <SolidColorBrush x:Key="BrushGaugeCommitArea" Color="#AAD4D47A"/>
        <SolidColorBrush x:Key="BrushGaugeCommitStroke" Color="#A16207"/>
        <SolidColorBrush x:Key="BrushGaugeRamFill" Color="#FDBA74"/>
        <SolidColorBrush x:Key="BrushGaugeRamArea" Color="#AAFDBA74"/>
        <SolidColorBrush x:Key="BrushGaugeRamStroke" Color="#EA580C"/>
        <SolidColorBrush x:Key="BrushGaugeIoReadFill" Color="#93C5FD"/>
        <SolidColorBrush x:Key="BrushGaugeIoReadArea" Color="#AA93C5FD"/>
        <SolidColorBrush x:Key="BrushGaugeIoReadStroke" Color="#3B82F6"/>
        <SolidColorBrush x:Key="BrushGaugeIoWriteArea" Color="#BBF9A8D4"/>
        <SolidColorBrush x:Key="BrushGaugeIoWriteStroke" Color="#DB2777"/>

        <Style x:Key="LblMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1.5,8,1.5"/>
        </Style>
        <Style x:Key="ValText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1.5,0,1.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ValNum" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="8,1.5,0,1.5"/>
            <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        </Style>
        <Style x:Key="ChartBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSparkBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushSparkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SysInfoTabControl" Grid.Row="0" Background="{DynamicResource BrushSurfaceBg}" BorderBrush="{DynamicResource BrushBorderSubtle}">
            <!-- TAB 1: SUMMARY -->
            <TabItem Header="Summary" Padding="10,3">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: System & Storage GroupBoxes -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="System" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Machine" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HwMachine}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Host" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HwHost}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Operating" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HwOS}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="CPU" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HwCpuName}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Architecture" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding HwArch}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Cores" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding HwCoresText}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Storage" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Memory" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HwMemoryGBText}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="Commit Lim" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding HwCommitLimitGBText}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Boot" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HwBootDrive}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Type" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding HwDriveType}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Capacity" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HwCapacityGBText}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Available" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding HwAvailableGBText}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="File System" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HwFileSystem}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="Read-Only" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="3" Grid.Column="4" Text="{Binding HwReadOnly}" Style="{StaticResource ValText}" Background="{DynamicResource BrushToolbarBg}" Padding="4,0"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Row 1: CPU Usage & System Commit -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CPU Usage Quadrant -->
                        <Grid x:Name="QuadCpu" Grid.Column="0" Background="Transparent" Cursor="Hand" ToolTip="Double-click to open CPU tab">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="CPU Usage" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartBorder}">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="44" Height="120" ClipToBounds="True">
                                        <Rectangle Width="44" Height="{Binding CpuGaugeTotalHeight}" Canvas.Left="0" Canvas.Top="{Binding CpuGaugeTotalTop}" Fill="{DynamicResource BrushGaugeCpuFill}" Stroke="{DynamicResource BrushGaugeCpuStroke}" StrokeThickness="0.8"/>
                                        <Rectangle Width="44" Height="{Binding CpuGaugeKernelHeight}" Canvas.Left="0" Canvas.Top="{Binding CpuGaugeKernelTop}" Fill="{DynamicResource BrushGaugeKernelFill}" Stroke="{DynamicResource BrushGaugeKernelStroke}" StrokeThickness="0.8"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CpuGaugeText}" HorizontalAlignment="Center" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                            <Border x:Name="BorderQuadCpuChart" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartBorder}" ToolTipService.IsEnabled="False">
                                <Viewbox Stretch="Fill">
                                    <Canvas x:Name="CanvasQuadCpu" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                        <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Polygon Points="{Binding SysCpuFillPoints}" Fill="{DynamicResource BrushGaugeCpuArea}" IsHitTestVisible="False"/>
                                        <Polyline Points="{Binding SysCpuPoints}" Stroke="{DynamicResource BrushGaugeCpuStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                        <Polygon Points="{Binding SysKernelFillPoints}" Fill="{DynamicResource BrushGaugeKernelArea}" IsHitTestVisible="False"/>
                                        <Polyline Points="{Binding SysKernelPoints}" Stroke="{DynamicResource BrushGaugeKernelStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                        <Line x:Name="CrosshairQuadCpu" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <!-- System Commit Quadrant -->
                        <Grid x:Name="QuadCommit" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Double-click to open Memory tab">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="System Commit" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartBorder}">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="44" Height="120" ClipToBounds="True">
                                        <Rectangle Width="44" Height="{Binding CommitGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding CommitGaugeTop}" Fill="{DynamicResource BrushGaugeCommitFill}" Stroke="{DynamicResource BrushGaugeCommitStroke}" StrokeThickness="0.8"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CommitGaugeText}" HorizontalAlignment="Center" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                            <Border x:Name="BorderQuadCommitChart" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartBorder}" ToolTipService.IsEnabled="False">
                                <Viewbox Stretch="Fill">
                                    <Canvas x:Name="CanvasQuadCommit" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                        <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Polygon Points="{Binding SysCommitFillPoints}" Fill="{DynamicResource BrushGaugeCommitArea}" IsHitTestVisible="False"/>
                                        <Polyline Points="{Binding SysCommitPoints}" Stroke="{DynamicResource BrushGaugeCommitStroke}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                                        <Line x:Name="CrosshairQuadCommit" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Row 2: Physical Memory & I/O -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Physical Memory Quadrant -->
                        <Grid x:Name="QuadRam" Grid.Column="0" Background="Transparent" Cursor="Hand" ToolTip="Double-click to open Memory tab">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Physical Memory" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartBorder}">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="44" Height="120" ClipToBounds="True">
                                        <Rectangle Width="44" Height="{Binding RamGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding RamGaugeTop}" Fill="{DynamicResource BrushGaugeRamFill}" Stroke="{DynamicResource BrushGaugeRamStroke}" StrokeThickness="0.8"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding RamGaugeText}" HorizontalAlignment="Center" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                            <Border x:Name="BorderQuadRamChart" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartBorder}" ToolTipService.IsEnabled="False">
                                <Viewbox Stretch="Fill">
                                    <Canvas x:Name="CanvasQuadRam" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                        <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Polygon Points="{Binding SysRamFillPoints}" Fill="{DynamicResource BrushGaugeRamArea}" IsHitTestVisible="False"/>
                                        <Polyline Points="{Binding SysRamPoints}" Stroke="{DynamicResource BrushGaugeRamStroke}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                                        <Line x:Name="CrosshairQuadRam" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>

                        <!-- I/O Quadrant -->
                        <Grid x:Name="QuadIo" Grid.Column="2" Background="Transparent" Cursor="Hand" ToolTip="Double-click to open I/O tab">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="I/O" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartBorder}">
                                <Viewbox Stretch="Fill">
                                    <Canvas Width="44" Height="120" ClipToBounds="True">
                                        <Rectangle Width="44" Height="{Binding IoGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding IoGaugeTop}" Fill="{DynamicResource BrushGaugeIoReadFill}" Stroke="{DynamicResource BrushGaugeIoReadStroke}" StrokeThickness="0.8"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding IoGaugeText}" HorizontalAlignment="Center" Margin="0,2,0,0" Typography.NumeralAlignment="Tabular"/>
                            <Border x:Name="BorderQuadIoChart" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartBorder}" ToolTipService.IsEnabled="False">
                                <Viewbox Stretch="Fill">
                                    <Canvas x:Name="CanvasQuadIo" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                        <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.7"/>
                                        <Polygon Points="{Binding SysIoFillPoints}" Fill="{DynamicResource BrushGaugeIoReadArea}" IsHitTestVisible="False"/>
                                        <Polyline Points="{Binding SysIoPoints}" Stroke="{DynamicResource BrushGaugeIoReadStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                        <Polygon Points="{Binding SysIoWriteFillPoints}" Fill="{DynamicResource BrushGaugeIoWriteArea}" IsHitTestVisible="False"/>
                                        <Polyline Points="{Binding SysIoWritePoints}" Stroke="{DynamicResource BrushGaugeIoWriteStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                        <Line x:Name="CrosshairQuadIo" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Row 3: Live Network Throughput Summary Strip (Double-Click for Network Tab) -->
                    <Border x:Name="QuadNet" Grid.Row="3" Margin="0,8,0,0" Padding="8,5" Background="{DynamicResource BrushToolbarBg}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="3" Cursor="Hand" ToolTipService.IsEnabled="False">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Network:" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <Rectangle Width="8" Height="8" Fill="{DynamicResource BrushNetRxStroke}" RadiusX="1" RadiusY="1" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Rx " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NetRxRateFormatted}" Style="{StaticResource ValNum}" Margin="0,0,10,0"/>
                                <Rectangle Width="8" Height="8" Fill="{DynamicResource BrushNetTxStroke}" RadiusX="1" RadiusY="1" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tx " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NetTxRateFormatted}" Style="{StaticResource ValNum}" Margin="0,0,12,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Session Total: " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NetSessionTotalFormatted}" Style="{StaticResource ValNum}" Margin="0,0,12,0"/>
                                <TextBlock Text="Scale Peak: " Foreground="{DynamicResource BrushTextMuted}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding NetPeakRateFormatted}" Style="{StaticResource ValNum}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="Double-click for Network tab" Foreground="{DynamicResource BrushAccent}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: CPU -->
            <TabItem Header="CPU" Padding="12,3">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="CPU" FontWeight="SemiBold" Margin="6,0,0,4"/>

                    <!-- Upper CPU Gauge + Chart Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Left Vertical CPU Bar Gauge -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="44" Height="120" ClipToBounds="True">
                                    <Rectangle Width="44" Height="{Binding CpuGaugeTotalHeight}" Canvas.Left="0" Canvas.Top="{Binding CpuGaugeTotalTop}" Fill="{DynamicResource BrushGaugeCpuFill}" Stroke="{DynamicResource BrushGaugeCpuStroke}" StrokeThickness="0.8"/>
                                    <Rectangle Width="44" Height="{Binding CpuGaugeKernelHeight}" Canvas.Left="0" Canvas.Top="{Binding CpuGaugeKernelTop}" Fill="{DynamicResource BrushGaugeKernelFill}" Stroke="{DynamicResource BrushGaugeKernelStroke}" StrokeThickness="0.8"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CpuGaugeText}" HorizontalAlignment="Center" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"/>

                        <!-- Combined Single CPU History Chart -->
                        <Border x:Name="BorderSysCpuChart" Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartBorder}" Visibility="{Binding SingleCpuGraphVisibility}">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="CanvasSysCpu" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                    <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Polygon Points="{Binding SysCpuFillPoints}" Fill="{DynamicResource BrushGaugeCpuArea}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysCpuPoints}" Stroke="{DynamicResource BrushGaugeCpuStroke}" StrokeThickness="1.0" IsHitTestVisible="False"/>
                                    <Polygon Points="{Binding SysKernelFillPoints}" Fill="{DynamicResource BrushGaugeKernelArea}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysKernelPoints}" Stroke="{DynamicResource BrushGaugeKernelStroke}" StrokeThickness="1.0" IsHitTestVisible="False"/>
                                    <Line x:Name="CrosshairSysCpu" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Per-CPU UniformGrid Charts (When 'Show one graph per CPU' is checked) -->
                        <ItemsControl x:Name="ItemsCoreGraphs" Grid.Row="0" Grid.Column="2" ItemsSource="{Binding CoreGraphs}" Visibility="{Binding PerCpuGridVisibility}" Background="Transparent">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Tag="CoreChartBorder" Style="{StaticResource ChartBorder}" Margin="2">
                                        <Grid Background="Transparent">
                                            <Viewbox Stretch="Fill">
                                                <Canvas Width="180" Height="80" ClipToBounds="True" Tag="CoreCanvas" Background="Transparent">
                                                    <Line X1="0" Y1="16" X2="180" Y2="16" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.5" IsHitTestVisible="False"/>
                                                    <Line X1="0" Y1="32" X2="180" Y2="32" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.5" IsHitTestVisible="False"/>
                                                    <Line X1="0" Y1="48" X2="180" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.5" IsHitTestVisible="False"/>
                                                    <Line X1="0" Y1="64" X2="180" Y2="64" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.5" IsHitTestVisible="False"/>
                                                    <Polygon Points="{Binding TotalFillPoints}" Fill="{DynamicResource BrushGaugeCpuArea}" IsHitTestVisible="False"/>
                                                    <Polyline Points="{Binding TotalPoints}" Stroke="{DynamicResource BrushGaugeCpuStroke}" StrokeThickness="1.0" IsHitTestVisible="False"/>
                                                    <Polygon Points="{Binding KernelFillPoints}" Fill="{DynamicResource BrushGaugeKernelArea}" IsHitTestVisible="False"/>
                                                    <Polyline Points="{Binding KernelPoints}" Stroke="{DynamicResource BrushGaugeKernelStroke}" StrokeThickness="1.0" IsHitTestVisible="False"/>
                                                    <Line Tag="CoreCrosshair" X1="0" Y1="0" X2="0" Y2="80" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                                </Canvas>
                                            </Viewbox>
                                            <TextBlock Text="{Binding CoreLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="5,2,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" IsHitTestVisible="False"/>
                                            <TextBlock Text="{Binding UsageFormatted}" FontSize="10" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,2,5,0" VerticalAlignment="Top" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular" IsHitTestVisible="False"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Bottom GroupBoxes: Totals, CPU, Topology -->
                    <Grid Grid.Row="2" Margin="0,8,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="185"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="195"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Totals" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Handles" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HandlesFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Threads" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThreadsFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Processes" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProcessesFormatted}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="CPU" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Context Switch Delta" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ContextSwitchDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Interrupt Delta" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InterruptDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="System Call Delta" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemCallDeltaFormatted}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="4" Header="Topology" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Cores" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding HwCoresCount}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Sockets" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding HwSocketsCount}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Logical Processors" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding HwLogicalCount}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <CheckBox x:Name="ChkPerCpuGraph" Grid.Row="3" Content="Show one graph per CPU" IsChecked="{Binding ShowOneGraphPerCpu}" Margin="2,2,0,0" Cursor="Hand"/>
                </Grid>
            </TabItem>

            <!-- TAB 3: MEMORY -->
            <TabItem Header="Memory" Padding="12,3">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- System Commit Wide Graph -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="System Commit" FontWeight="SemiBold" Margin="6,0,0,3"/>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartBorder}" Margin="6,0,0,0">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="44" Height="120" ClipToBounds="True">
                                    <Rectangle Width="44" Height="{Binding CommitGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding CommitGaugeTop}" Fill="{DynamicResource BrushGaugeCommitFill}" Stroke="{DynamicResource BrushGaugeCommitStroke}" StrokeThickness="0.8"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CommitGaugeText}" HorizontalAlignment="Center" Margin="6,2,0,0" Typography.NumeralAlignment="Tabular"/>
                        <Border x:Name="BorderMemCommitChart" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="CanvasMemCommit" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                    <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Polygon Points="{Binding SysCommitFillPoints}" Fill="{DynamicResource BrushGaugeCommitArea}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysCommitPoints}" Stroke="{DynamicResource BrushGaugeCommitStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                    <Line x:Name="CrosshairMemCommit" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Physical Memory Wide Graph -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Physical Memory" FontWeight="SemiBold" Margin="6,0,0,3"/>
                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ChartBorder}" Margin="6,0,0,0">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="44" Height="120" ClipToBounds="True">
                                    <Rectangle Width="44" Height="{Binding RamGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding RamGaugeTop}" Fill="{DynamicResource BrushGaugeRamFill}" Stroke="{DynamicResource BrushGaugeRamStroke}" StrokeThickness="0.8"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding RamGaugeText}" HorizontalAlignment="Center" Margin="6,2,0,0" Typography.NumeralAlignment="Tabular"/>
                        <Border x:Name="BorderMemRamChart" Grid.Row="1" Grid.Column="2" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="CanvasMemRam" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                    <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Polygon Points="{Binding SysRamFillPoints}" Fill="{DynamicResource BrushGaugeRamArea}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysRamPoints}" Stroke="{DynamicResource BrushGaugeRamStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                    <Line x:Name="CrosshairMemRam" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <!-- Bottom Memory Counter GroupBoxes -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Commit Charge (K) + Physical Memory (K) -->
                        <StackPanel Grid.Column="0">
                            <GroupBox Header="Commit Charge (K)" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Current" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CommitCurrentK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Limit" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommitLimitK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Peak" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CommitPeakK}" Style="{StaticResource ValNum}"/>
                                    <Separator Grid.Row="3" Grid.ColumnSpan="2" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Peak/Limit" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CommitPeakLimitPct}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Current/Limit" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CommitCurrentLimitPct}" Style="{StaticResource ValNum}"/>
                                </Grid>
                            </GroupBox>

                            <GroupBox Header="Physical Memory (K)" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Total" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PhysTotalK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Available" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhysAvailableK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="In Use" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PhysInUseK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="System Cache (WS)" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemCacheK}" Style="{StaticResource ValNum}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 2: Kernel Memory (K) -->
                        <StackPanel Grid.Column="2">
                            <GroupBox Header="Kernel Memory (K)" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="6"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Paged Pool" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding KernelPagedK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Nonpaged Pool" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding KernelNonpagedK}" Style="{StaticResource ValNum}"/>
                                    <Separator Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource BrushBorderSubtle}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Total Kernel" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding KernelTotalK}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Nonpaged Limit" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PhysTotalK}" Style="{StaticResource ValNum}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>

                        <!-- Column 4: Paging -->
                        <StackPanel Grid.Column="4">
                            <GroupBox Header="Paging" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Page Fault Delta" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PageFaultDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Page Read Delta" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PageReadDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Paging File Write Delta" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PageFileWriteDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Mapped File Write Delta" Style="{StaticResource ValText}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding MappedFileWriteDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                </Grid>
                            </GroupBox>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 4: I/O -->
            <TabItem Header="I/O" Padding="12,3">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="I/O Bytes History (Blue: Read + Write + Other | Pink: Write + Other)" FontWeight="SemiBold" Margin="6,0,0,4"/>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="44" Height="120" ClipToBounds="True">
                                    <Rectangle Width="44" Height="{Binding IoGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding IoGaugeTop}" Fill="{DynamicResource BrushGaugeIoReadFill}" Stroke="{DynamicResource BrushGaugeIoReadStroke}" StrokeThickness="0.8"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding IoGaugeText}" HorizontalAlignment="Center" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"/>
                        <Border x:Name="BorderSysIoChart" Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="CanvasSysIo" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                    <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Polygon Points="{Binding SysIoFillPoints}" Fill="{DynamicResource BrushGaugeIoReadArea}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysIoPoints}" Stroke="{DynamicResource BrushGaugeIoReadStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                    <Polygon Points="{Binding SysIoWriteFillPoints}" Fill="{DynamicResource BrushGaugeIoWriteArea}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysIoWritePoints}" Stroke="{DynamicResource BrushGaugeIoWriteStroke}" StrokeThickness="1.1" IsHitTestVisible="False"/>
                                    <Line x:Name="CrosshairSysIo" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="I/O Transfer Delta (Per Tick)" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Total I/O Rate" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IoTotalRateFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Read Transfer Delta" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IoReadDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Write Transfer Delta" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IoWriteDeltaFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Other Transfer Delta" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding IoOtherDeltaFormatted}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="I/O Scaling &amp; Session Totals" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Peak I/O Rate (4m Window)" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IoPeakRateFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Session Cumulative I/O" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding IoSessionTotalFormatted}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 5: NETWORK -->
            <TabItem Header="Network" Padding="12,3">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Chart Title & Theme-Consistent Series Legend -->
                    <DockPanel Grid.Row="0" Margin="6,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Rectangle Width="10" Height="10" Fill="{DynamicResource BrushNetRxStroke}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Receive (Rx)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Rectangle Width="10" Height="10" Fill="{DynamicResource BrushNetTxStroke}" RadiusX="1.5" RadiusY="1.5" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Send (Tx)" Foreground="{DynamicResource BrushTextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Network Interface Throughput History (Auto-Scaled Total &amp; Split Rx / Tx)" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <!-- Gauge + 240-Sample Rx/Tx Chart + Dynamic Scale Axis -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas Width="44" Height="120" ClipToBounds="True">
                                    <Rectangle Width="44" Height="{Binding NetGaugeHeight}" Canvas.Left="0" Canvas.Top="{Binding NetGaugeTop}" Fill="{DynamicResource BrushNetRxFill}" Stroke="{DynamicResource BrushNetRxStroke}" StrokeThickness="0.9"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding NetGaugeText}" HorizontalAlignment="Center" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"/>

                        <Border x:Name="BorderSysNetChart" Grid.Row="0" Grid.Column="2" Style="{StaticResource ChartBorder}">
                            <Viewbox Stretch="Fill">
                                <Canvas x:Name="CanvasSysNet" Width="360" Height="120" ClipToBounds="True" Background="Transparent">
                                    <Line X1="0" Y1="12" X2="360" Y2="12" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="24" X2="360" Y2="24" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="36" X2="360" Y2="36" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="48" X2="360" Y2="48" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="60" X2="360" Y2="60" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="72" X2="360" Y2="72" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="84" X2="360" Y2="84" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="96" X2="360" Y2="96" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Line X1="0" Y1="108" X2="360" Y2="108" Stroke="{DynamicResource BrushSparkGrid}" StrokeThickness="0.6"/>
                                    <Polygon Points="{Binding SysNetRxFillPoints}" Fill="{DynamicResource BrushNetRxFill}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysNetRxPoints}" Stroke="{DynamicResource BrushNetRxStroke}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                                    <Polygon Points="{Binding SysNetTxFillPoints}" Fill="{DynamicResource BrushNetTxFill}" IsHitTestVisible="False"/>
                                    <Polyline Points="{Binding SysNetTxPoints}" Stroke="{DynamicResource BrushNetTxStroke}" StrokeThickness="1.2" IsHitTestVisible="False"/>
                                    <Line x:Name="CrosshairSysNet" X1="0" Y1="0" X2="0" Y2="120" Stroke="{DynamicResource BrushAccent}" StrokeThickness="1.2" Opacity="0.85" Visibility="Collapsed" IsHitTestVisible="False"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <!-- Right Y-Axis Scale Labels -->
                        <Grid Grid.Row="0" Grid.Column="3" Margin="8,2,0,2" MinWidth="68">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding NetPeakRateFormatted}" Foreground="{DynamicResource BrushTextSecondary}" FontSize="10.5" HorizontalAlignment="Left" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Grid.Row="2" Text="{Binding NetMidRateFormatted}" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" HorizontalAlignment="Left" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Grid.Row="4" Text="0 B/s" Foreground="{DynamicResource BrushTextMuted}" FontSize="10.5" HorizontalAlignment="Left" Typography.NumeralAlignment="Tabular"/>
                        </Grid>
                    </Grid>

                    <!-- Bottom GroupBoxes: Live Throughput & Scaling/Session Totals -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="270"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Grid.Column="0" Header="Interface Throughput (Per Second)" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Combined Rate" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NetTotalRateFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Receive (Rx)" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetRxRateFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Send (Tx)" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NetTxRateFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="ETW Attribution" Style="{StaticResource LblMuted}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetEtwStatusSummary}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Column="2" Header="Scaling &amp; Session Totals" BorderBrush="{DynamicResource BrushBorderSubtle}" Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Scale Peak (4m Window)" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NetPeakRateFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Session Received" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetSessionRxFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Session Sent" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NetSessionTxFormatted}" Style="{StaticResource ValNum}"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Session Combined" Style="{StaticResource ValText}"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding NetSessionTotalFormatted}" Style="{StaticResource ValNum}"/>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="BtnSysInfoOk" Content="OK" Width="88" Height="26" IsDefault="True" Background="{DynamicResource BrushSurfaceBg}" Foreground="{DynamicResource BrushTextPrimary}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
