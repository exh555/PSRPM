# Auto-detect text files and normalize line endings
* text=auto

# Keep PowerShell scripts, manifests, and XAML with Windows CRLF line endings
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.xaml text eol=crlf

# Keep Markdown and YAML with standard LF line endings
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary media and icons
*.ico binary
*.png binary
